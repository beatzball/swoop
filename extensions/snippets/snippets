#!/usr/bin/env bash
# snippets: named text, one row each, pasted into the app in front on
# Enter with {date}, {time}, {clipboard} and {uuid} filled and the caret
# left at {cursor}. The work is in swoop-snippets, a Go tool in bin/,
# which reads ~/.config/swoop/snippets/, one markdown file per snippet,
# and also adds to it and imports a JSON export. This shim is here so the
# rows are routed like every other extension. See cmd/swoop-snippets.
exec swoop-snippets "$@"
