#!/usr/bin/env bash
# reminders: Apple Reminders as a view, on a Mac. One root row opens it:
# every open reminder in every list, under headers by when it is due,
# Past due to Unscheduled. Enter completes a reminder and the view stays,
# reloaded. Text typed becomes an Add reminder row, and the date words at
# its end ("tomorrow", "friday", "2026-10-01") become its due day. The
# date words and the headers are swoop-tasks', so both checklists read
# and group alike.
#
# Everything goes through osascript, in JavaScript for Automation. The
# list is read through EventKit, the framework Reminders itself sits on,
# in a tenth of a second; asked through Apple Events, Reminders takes ten
# seconds for every property of every reminder, and a minute for the list.
# EventKit needs Reminders under Privacy & Security for the app the tool
# runs in; without it, the list is read the slow way. Changes (complete, delete,
# add) go through Apple Events, one reminder each.
#
# The view never waits for Reminders: the launcher gives a view two
# seconds. It answers from a cache, however old, or with a Loading row
# when there is none, and a fetch in the background fills the cache and
# asks fzf to reload the pane. One fetch at a time; the cache is good for
# a minute. The first call asks for permission; until it is given, the
# view says so.
#
# On other systems there is no Reminders, and `list` prints nothing.
set -euo pipefail

[ "$(uname)" = Darwin ] || exit 0

# The tool this runs under, the word in its folders. The launcher gives
# it in SWOOP_TOOL_NAME; run by hand, with no launcher, it is the kit's
# own. The cache is in that tool's state folder, and what the view says
# about permission names that tool.
tool="${SWOOP_TOOL_NAME:-swoop}"
dir="${XDG_STATE_HOME:-$HOME/.local/state}/$tool/reminders"
cache="$dir/reminders.tsv"
lock="$dir/fetch.lock"
# denied is left by a fetch that failed, most likely for want of
# permission, so the view can say so instead of Loading for ever.
denied="$dir/denied"
ttl=60
settings='x-apple.systempreferences:com.apple.preference.security?Privacy_Reminders'

row() { printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$5"; }
clean() { printf '%s' "$1" | tr '\t\r\n' '   '; }

# fetch prints every open reminder, one per line: id, due day, due time
# (empty for none or midnight), list, name. EventKit first; when it is
# not allowed (it fails at once), Apple Events.
fetch() {
  fetch_eventkit || fetch_events
}

# fetch_eventkit asks EventKit for the incomplete reminders, in one call.
# The ids are Apple Events', x-apple-reminder:// and the item's id, so
# Enter completes the same reminder either way. A due date with no hour
# is an all-day one: the hour is NSUndefinedDateComponent, a huge number.
fetch_eventkit() {
  # $ is the ObjC bridge in JavaScript, not a shell expansion.
  # shellcheck disable=SC2016
  osascript -l JavaScript -e '
ObjC.import("EventKit");
function run() {
  const full = 3; // EKAuthorizationStatusFullAccess
  if (Number($.EKEventStore.authorizationStatusForEntityType($.EKEntityTypeReminder)) !== full)
    throw new Error("EventKit: no access to Reminders");
  const store = $.EKEventStore.alloc.init;
  const pred = store.predicateForIncompleteRemindersWithDueDateStartingEndingCalendars($(), $(), $());
  let got = null;
  store.fetchRemindersMatchingPredicateCompletion(pred, rs => { got = rs; });
  const end = Date.now() + 20000;
  while (got === null && Date.now() < end)
    $.NSRunLoop.currentRunLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.01));
  if (got === null) throw new Error("EventKit: no answer");
  const pad = n => (n < 10 ? "0" : "") + n;
  const str = s => (s.isNil() ? "" : s.js).replace(/[\t\r\n]+/g, " ");
  const out = [];
  for (let i = 0; i < got.count; i++) {
    const r = got.objectAtIndex(i);
    const c = r.dueDateComponents;
    let day = "", hm = "";
    if (!c.isNil()) {
      day = c.year + "-" + pad(c.month) + "-" + pad(c.day);
      if (c.hour < 24 && (c.hour || c.minute)) hm = pad(c.hour) + ":" + pad(c.minute < 60 ? c.minute : 0);
    }
    out.push(["x-apple-reminder://" + r.calendarItemIdentifier.js, day, hm, str(r.calendar.title), str(r.title)].join("\t"));
  }
  return out.join("\n");
}'
}

# fetch_events asks Reminders through Apple Events, a list at a time.
# Slow: every property read is a pass over every reminder.
fetch_events() {
  osascript -l JavaScript -e '
function run() {
  const R = Application("Reminders");
  const pad = n => (n < 10 ? "0" : "") + n;
  const clean = s => String(s === null || s === undefined ? "" : s).replace(/[\t\r\n]+/g, " ");
  const out = [];
  R.lists().forEach(l => {
    const rs = l.reminders.whose({completed: false});
    const ids = rs.id(), names = rs.name(), dues = rs.dueDate();
    const list = clean(l.name());
    for (let i = 0; i < ids.length; i++) {
      const d = dues[i];
      let day = "", hm = "";
      if (d) {
        day = d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate());
        if (d.getHours() || d.getMinutes()) hm = pad(d.getHours()) + ":" + pad(d.getMinutes());
      }
      out.push([ids[i], day, hm, list, clean(names[i])].join("\t"));
    }
  });
  return out.join("\n");
}'
}

# fresh says whether the cache is younger than ttl seconds.
fresh() {
  [ -f "$cache" ] || return 1
  local age=$(( $(date +%s) - $(stat -f %m "$cache") ))
  [ "$age" -lt "$ttl" ]
}

# refresh starts a fetch in the background, unless one is running, and
# returns at once. The lock is a directory, since mkdir either makes it
# or fails, atomically; one older than two minutes was left by a fetch
# that died. The fetch's streams go to /dev/null: the launcher reads the
# view's stdout until it closes, and would wait for the fetch too.
refresh() {
  mkdir -p "$dir"
  if ! mkdir "$lock" 2>/dev/null; then
    [ -n "$(find "$lock" -maxdepth 0 -mmin +2 2>/dev/null)" ] || return 0
    rm -rf "$lock"
    mkdir "$lock" 2>/dev/null || return 0
  fi
  (
    trap 'rm -rf "$lock"' EXIT
    tmp="$cache.fetch"
    if fetch > "$tmp"; then
      mv "$tmp" "$cache"
      rm -f "$denied"
    else
      rm -f "$tmp"
      : > "$denied"
    fi
    redraw
  ) < /dev/null > /dev/null 2>&1 &
}

# redraw asks the fzf that shows the pane to reload it, through the socket
# bin/swoop gave it, as swoop-ai's worker does. Outside a launcher there
# is none, and the next keystroke shows the new list.
redraw() {
  local sock="${FZF_SOCK:-${SWOOP_STATE:+$SWOOP_STATE.sock}}"
  [ -n "$sock" ] || return 0
  curl -s -m 2 --unix-socket "$sock" -H "x-api-key: ${FZF_API_KEY:-}" \
    --data-binary 'reload(swoop-nav rows {q})' http://fzf/ > /dev/null || true
}

# forget takes one reminder out of the cache, so the view reloads without
# it at once instead of asking Reminders again.
forget() {
  [ -f "$cache" ] || return 0
  awk -F '\t' -v id="$1" '$1 != id' "$cache" > "$cache.$$" && mv "$cache.$$" "$cache"
}

# remember puts one new reminder's line in the cache, the same way. With
# no cache there is nothing to patch: a cache of that one line would look
# like the whole list, and the next view fetches anyway.
remember() {
  [ -f "$cache" ] || return 0
  printf '%s\n' "$1" >> "$cache"
}

# field prints field $2 of reminder $1's cached line: 2 the due day, 3
# the time, 4 the list, 5 the name. awk, not read: a tab is whitespace to
# read, so an empty field in the middle would shift the rest left. From
# the cache only: a row on screen came from it.
field() {
  [ -f "$cache" ] || return 0
  awk -F '\t' -v id="$1" -v n="$2" '$1 == id { print $n; exit }' "$cache"
}

# rows prints the view's reminder rows, filtered by every word of $1,
# under a header for each group that has any: Past due, Today, Tomorrow,
# This week, This month, Later, Unscheduled. The filter is swoop-match,
# the matcher every view shares: the first awk gives it each reminder as
# a protocol row, the name as the title and the list as the subtitle, and
# it gives back the ones that match, the best first. The second awk finds
# each of those in the cache again, and puts the due day first; the sort
# is by day and then hour, and it is stable, so reminders due at the same
# time stay best first; swoop-tasks group keeps that order inside a group
# and says which group each is in, by the same rules and the same week
# setting as Tasks; the last awk prints a header, kind "group", over each
# run of one group.
rows() {
  local today tomorrow
  today=$(date +%F)
  tomorrow=$(date -v+1d +%F)
  awk -F '\t' '{ printf "%s\ttoggle\t\t%s\t%s\n", $1, $5, $4 }' "$cache" | swoop-match "$1" |
  awk -F '\t' '
    BEGIN { OFS = "\t" }
    NR == FNR { line[$1] = $2 OFS $3 OFS $1 OFS $4 OFS $5; next }
    $1 in line { print line[$1] }' "$cache" - | sort -t "$(printf '\t')" -k1,1 -k2,2 -s | swoop-tasks group |
  awk -F '\t' -v today="$today" -v tomorrow="$tomorrow" '
    { group[NR] = $1; day[NR] = $2; hm[NR] = $3; id[NR] = $4; list[NR] = $5; name[NR] = $6; count[$1]++ }
    END {
      for (i = 1; i <= NR; i++) {
        if (i == 1 || group[i] != group[i - 1])
          printf "group:%s\tgroup\t\t%s\t%d reminder%s\n", group[i], group[i], count[group[i]], (count[group[i]] == 1 ? "" : "s")
        if (day[i] == "") when = ""
        else if (day[i] < today) when = "overdue, " day[i]
        else if (day[i] == today) when = "today"
        else when = (day[i] == tomorrow ? "tomorrow" : day[i])
        if (hm[i] != "") when = when " " hm[i]
        note = (when == "" ? list[i] : when " · " list[i])
        printf "r:%s\ttoggle\t󰄱\t%s\t%s\n", id[i], name[i], note
      }
    }'
}

case "${1:-}" in
  list)
    row reminders view '' 'Reminders' 'Apple Reminders: past due and today first'
    ;;
  view)
    query="${3:-}"
    text=''
    if [ -n "$(printf '%s' "$query" | tr -d ' ')" ]; then
      parsed=$(swoop-tasks parse "$query")
      text="${parsed%%$'\t'*}"
      due="${parsed#*$'\t'}"
      row "add:$(clean "$query")" toggle '󰐕' "Add reminder: $text" "${due:+due $due}"
    fi
    # The filter is the text without its date words: "milk friday" is
    # about to add a reminder, and still finds the milk one already there.
    if [ -f "$cache" ]; then
      rows "$text"
    elif [ -f "$denied" ]; then
      row perm command '' 'Reminders is not allowed yet' 'Enter opens Privacy & Security to allow it'
    else
      row loading toggle '󰔟' 'Loading reminders…' 'The list appears here in a moment'
    fi
    fresh || refresh
    ;;
  preview)
    id="${2:-}"
    case "$id" in
      reminders)
        echo 'Your open reminders, every list, grouped by when they are due.'
        echo
        echo 'Enter completes one. Type to filter, or to add: end the text'
        echo 'with today, tomorrow, a weekday or 2026-10-01 to give it a day.'
        ;;
      perm)
        echo "$tool asks Reminders through osascript. Turn on Reminders"
        echo "for the app $tool runs in, under Privacy & Security."
        echo
        # A switch that shows on may hold a grant for an earlier build.
        # The Reminders pane has no minus button, so the reset is tccutil.
        echo 'Already on? A new build needs a new grant: run'
        echo 'tccutil reset Reminders, then allow it again when asked.'
        ;;
      group:*)
        echo "${id#group:}"
        echo
        echo 'The reminders due then, the soonest first.'
        ;;
      add:*)
        parsed=$(swoop-tasks parse "${id#add:}")
        echo 'Enter adds to your default list:'
        echo
        echo "${parsed%%$'\t'*}"
        due="${parsed#*$'\t'}"
        echo
        if [ -n "$due" ]; then echo "due $due"; else echo 'no due date'; fi
        ;;
      r:*)
        rid="${id#r:}"
        day=$(field "$rid" 2) hm=$(field "$rid" 3) list=$(field "$rid" 4)
        field "$rid" 5
        echo
        if [ -n "$day" ]; then echo "due $day${hm:+ $hm}"; else echo 'no due date'; fi
        echo "in $list"
        echo
        echo 'Enter completes it.'
        ;;
    esac
    ;;
  actions)
    case "${2:-}" in
      r:*)
        row complete refresh '󰄲' 'Complete' 'Enter'
        row delete refresh '' 'Delete' 'Remove it from Reminders'
        row copy action '' 'Copy' "The reminder's text"
        ;;
    esac
    ;;
  run)
    id="${2:-}"
    action="${3:-complete}"
    case "$id" in
      perm) open "$settings" ;;
      # Enter on Loading only reloads the pane, as a toggle does.
      loading) ;;
      # A header has nothing to run; the launcher does not ask.
      group:*) ;;
      add:*)
        parsed=$(swoop-tasks parse "${id#add:}")
        text="${parsed%%$'\t'*}"
        due="${parsed#*$'\t'}"
        [ -n "$text" ] || exit 0
        # An all-day due date: the date words name a day, not an hour.
        # It prints the new one's id and list, for the cache.
        made=$(osascript -l JavaScript -e '
function run(a) {
  const R = Application("Reminders");
  const p = {name: a[0]};
  if (a[1]) {
    const d = a[1].split("-").map(Number);
    p.alldayDueDate = new Date(d[0], d[1] - 1, d[2]);
  }
  const r = R.Reminder(p);
  R.defaultList.reminders.push(r);
  try { return r.id() + "\t" + R.defaultList.name(); } catch (e) { return ""; }
}' "$text" "$due")
        # The pane shows it at once from the cache. Without an id to put
        # there, the cache is aged instead, so the view asks again.
        case "$made" in
          *$'\t'*) remember "${made%%$'\t'*}"$'\t'"$due"$'\t\t'"$(clean "${made#*$'\t'}")"$'\t'"$(clean "$text")" ;;
          *) [ ! -f "$cache" ] || touch -t 200001010000 "$cache" ;;
        esac
        ;;
      r:*)
        rid="${id#r:}"
        case "$action" in
          complete)
            osascript -l JavaScript -e 'function run(a) { Application("Reminders").reminders.byId(a[0]).completed = true; }' "$rid" > /dev/null
            forget "$rid"
            ;;
          delete)
            osascript -l JavaScript -e 'function run(a) { Application("Reminders").reminders.byId(a[0]).delete(); }' "$rid" > /dev/null
            forget "$rid"
            ;;
          copy)
            name=$(field "$rid" 5)
            printf '%s' "$name" | pbcopy
            echo "Copied $name" >&2
            ;;
          *) echo "no action $action for a reminder" >&2; exit 2 ;;
        esac
        ;;
      *) echo "unknown id: $id" >&2; exit 2 ;;
    esac
    ;;
  *)
    echo "usage: reminders list | view reminders [text] | preview <id> | actions <id> | run <id> [complete|delete|copy]" >&2
    exit 2
    ;;
esac
