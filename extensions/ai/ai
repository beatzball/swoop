#!/usr/bin/env bash
# ai: the Ask AI pane, the one Tab opens. The work is in swoop-ai, a Go
# tool in bin/, because streaming an answer into a file while telling fzf
# to redraw is more than a shell script should carry. This shim is here so
# the pane is routed like every other extension: `ext/ai/<id>` ids, and
# the same view, preview, actions and run verbs. See cmd/swoop-ai.
exec swoop-ai "$@"
