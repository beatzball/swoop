#!/usr/bin/env bash
# swoop: the launcher, as one fzf call. Runs in any terminal on any OS.
#
# swoop-list prints result lines; fzf shows and filters them; Enter hands the
# picked id to swoop-run, which replaces fzf (become) so nothing is left
# running. The built binaries live beside this script, in bin/, which is why
# it is the one tracked file there (see .gitignore).
set -euo pipefail
status=0

# The tools are found by this script's own directory, not by PATH alone, so
# a stale swoop-list elsewhere on PATH never answers for ours. Follow
# symlinks first: scripts/get links ~/.local/bin/swoop to this file, and the
# tools are beside the file, not beside the link. A loop rather than
# readlink -f, which the bash and readlink of older macOS do not have.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  link="$(readlink "$src")"
  case "$link" in
    /*) src="$link" ;;
    *) src="$(dirname "$src")/$link" ;;
  esac
done
here="$(cd -P "$(dirname "$src")" && pwd)"
export PATH="$here:$PATH"
# The extensions bundled in the repository, next to the user's own in
# ~/.config/swoop/extensions. The user's win when names collide.
export SWOOP_EXTENSIONS="$here/../extensions${SWOOP_EXTENSIONS:+:$SWOOP_EXTENSIONS}"

# The line is: id, kind, icon, title, subtitle, tab-separated.
#   --with-nth   a template: show "icon title", then a tab, then the subtitle;
#                the id and kind stay hidden. {1} in the enter binding is still
#                the ORIGINAL first field, the id: placeholders read the input
#                line, only --nth reads the transformed one
#   --nth 1      match on field 1 of the TRANSFORMED line, "icon title", never
#                on the subtitle, so typing "app" does not match every row
#                that lives under /Applications
#   --tabstop 1  the one tab left in the row is a 1-column gap, not a jump to
#                the next 8-column stop, so subtitles line up after the title
#   --tiebreak   prefer matches at the start, then shorter titles, so typing
#                "saf" puts Safari above "Safari Technology Preview"
#   left-click:  a click on a row is Enter on that row. fzf moves the
#                cursor to the clicked row before it runs the binding, so
#                {1} is the row under the mouse
#   ctrl-u, ctrl-d:
#                scroll the preview half a page, the way preen and the
#                usual terminal tools do. fzf's own ctrl-u clears the bar,
#                which Esc does here anyway
#   --preview-window:
#                58% for the preview: an app's details and an AI answer
#                need the room more than the list does. nav has the same
#                string, for the panes that change the window and put it
#                back
#   ctrl-k:      the row's actions as a pane of their own; cmd+K in the
#                frame is mapped to it. fzf's own ctrl-k is "up", which the
#                arrow key still does
#   tab:         opens the Ask AI pane with what is in the bar; Enter there
#                sends it, and the answer arrives on the right. See
#                cmd/swoop-ai
#   --listen:    fzf's HTTP API on a socket of this run's own, so the
#                worker that streams an answer can tell fzf to redraw the
#                preview as it goes. The key keeps anything else out
#   enter, esc, change:
#                all three go through swoop-nav, which prints the actions:
#                Enter runs a row or opens a view; Esc clears the bar,
#                then pops a view, then closes; typing inside a view asks
#                the extension for new rows; typing at the root asks the
#                extensions with the text while fzf matches the apps
icons="$(mktemp "${TMPDIR:-/tmp}/swoop-icons.XXXXXX")"
rows="$(mktemp "${TMPDIR:-/tmp}/swoop-rows.XXXXXX")"
# The built-in rows, pictures attached, listed once. Every reload at the
# root reads this file and asks only the extensions again, with the text
# in the bar: that is how a calculator row appears while you type.
SWOOP_APPS="$(mktemp "${TMPDIR:-/tmp}/swoop-apps.XXXXXX")"
export SWOOP_APPS
# Where swoop-nav keeps the stack of panes for this run. Enter, Esc, and
# typing all go through swoop-nav, which prints the fzf actions to take;
# see internal/nav for the rules. The file is removed on exit, and by the
# run command itself when Enter replaces fzf.
SWOOP_STATE="$(mktemp "${TMPDIR:-/tmp}/swoop-state.XXXXXX")"
export SWOOP_STATE
# fzf's API, for the Ask AI worker: a Unix socket beside the state file,
# which fzf exports to its children as FZF_SOCK, or a localhost port on
# Windows, exported as FZF_PORT. Requests need the key.
sock="$SWOOP_STATE.sock"
listen="$sock"
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) listen=0 ;;
esac
FZF_API_KEY="$(head -c 24 /dev/urandom | base64)"
export FZF_API_KEY
# The clipboard watcher outlives the launcher; start it if none runs. It
# is the one part of swoop that runs while the launcher is closed.
swoop-clipd start || true
swoop-list | swoop-icons -out "$icons" > "$SWOOP_APPS"
swoop-nav rows > "$rows"
fzf < "$rows" \
  --ansi \
  --bind "start:execute-silent(cat '$icons' > /dev/tty; rm -f '$icons' '$rows')" \
  --delimiter $'\t' \
  --with-nth $'{3} {4}  \t{5}' \
  --nth 1 \
  --tabstop 1 \
  --tiebreak 'begin,length' \
  --layout reverse \
  --no-info \
  --prompt '  ' \
  --pointer '▶' \
  --preview 'swoop-preview {1}' \
  --preview-window 'right,58%,border-left,nowrap' \
  --bind 'ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down' \
  --bind 'enter:transform:swoop-nav enter {1} {2} {4}' \
  --bind 'left-click:transform:swoop-nav enter {1} {2} {4}' \
  --bind 'ctrl-k:transform:swoop-nav actions {1} {2} {4}' \
  --bind 'tab:transform:swoop-nav ai' \
  --listen "$listen" \
  --bind 'esc:transform:swoop-nav esc' \
  --bind 'change:transform:swoop-nav change' || status=$?
rm -f "$icons" "$rows" "$SWOOP_STATE" "$SWOOP_APPS" "$sock"
# Inside a frame of our own, tell it we are leaving, so it can put the
# panel away before the terminal prints "Process exited".
[ -n "${SWOOP_SHELL_PID:-}" ] && kill -USR2 "$SWOOP_SHELL_PID" 2>/dev/null
# Esc and ctrl-c make fzf exit 130. Closing the launcher is not a failure,
# and Ghostty treats a fast non-zero exit as one: it keeps the pane open
# with "Process exited" until a key is pressed. Anything else is real.
[ "$status" -eq 130 ] && status=0
exit "$status"
