#!/usr/bin/env bash
# swoop: the launcher, as one fzf call. Runs in any terminal on any OS.
#
# swoop-list prints result lines; fzf shows and filters them; Enter hands the
# picked id to swoop-run, which replaces fzf (become) so nothing is left
# running. The built binaries live beside this script, in bin/, which is why
# it is the one tracked file there (see .gitignore).
set -euo pipefail
status=0

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$here:$PATH"

# The line is: id, kind, icon, title, subtitle, tab-separated.
#   --with-nth   a template: show "icon title", then a tab, then the subtitle;
#                the id and kind stay hidden. {1} in the enter binding is still
#                the ORIGINAL first field, the id: placeholders read the input
#                line, only --nth reads the transformed one
#   --nth 1      match on field 1 of the TRANSFORMED line, "icon title", never
#                on the subtitle, so typing "app" does not match every row
#                that lives under /Applications
#   --tabstop 1  the one tab left in the row is a 1-column gap, not a jump to
#                the next 8-column stop, so subtitles line up after the title
#   --tiebreak   prefer matches at the start, then shorter titles, so typing
#                "saf" puts Safari above "Safari Technology Preview"
#   --preview    swoop-preview draws the highlighted result on the right:
#                its icon as a real picture, then a few facts. nowrap keeps
#                the picture's placeholder rows whole
#   --ansi       rows carry colour, and the icon cells carry their picture's
#                id in that colour; without --ansi the pictures are gone
#   start:       the icons themselves wait in a file until fzf is up: the
#                terminal keeps pictures per screen, and fzf draws on the
#                alternate screen, so anything sent earlier would be lost.
#                fzf fires start within milliseconds, so the rows and the
#                icon file are both finished BEFORE fzf starts; otherwise
#                start could send a half-written file. That costs about
#                20 ms of delay before the list appears, and no race
icons="$(mktemp "${TMPDIR:-/tmp}/swoop-icons.XXXXXX")"
rows="$(mktemp "${TMPDIR:-/tmp}/swoop-rows.XXXXXX")"
swoop-list | swoop-icons -out "$icons" > "$rows"
fzf < "$rows" \
  --ansi \
  --bind "start:execute-silent(cat '$icons' > /dev/tty; rm -f '$icons' '$rows')" \
  --delimiter $'\t' \
  --with-nth $'{3} {4}  \t{5}' \
  --nth 1 \
  --tabstop 1 \
  --tiebreak 'begin,length' \
  --layout reverse \
  --no-info \
  --prompt '  ' \
  --pointer '▶' \
  --preview 'swoop-preview {1}' \
  --preview-window 'right,45%,border-left,nowrap' \
  --bind 'enter:become(swoop-run {1})' || status=$?
rm -f "$icons" "$rows"
exit "${status:-0}"
