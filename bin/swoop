#!/usr/bin/env bash
# swoop: swoopkit's launcher, as one fzf call. Runs in any terminal on any
# OS. The tool it runs as, its name and folders, comes from the file `tool`.
#
# The extensions print result lines; fzf shows and filters them; Enter hands
# the picked id to swoop-run, which replaces fzf (become) so nothing is left
# running. The built binaries live beside this script, in bin/, which is why
# it is the one tracked file there (see .gitignore).
set -euo pipefail
status=0

# The tools are found by this script's own directory, not by PATH alone, so
# a stale swoop-nav elsewhere on PATH never answers for ours. Follow
# symlinks first: scripts/get links ~/.local/bin/<name> to this file, and the
# tools are beside the file, not beside the link. A loop rather than
# readlink -f, which the bash and readlink of older macOS do not have.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  link="$(readlink "$src")"
  case "$link" in
    /*) src="$link" ;;
    *) src="$(dirname "$src")/$link" ;;
  esac
done
here="$(cd -P "$(dirname "$src")" && pwd)"
export PATH="$here:$PATH"
# The tool this launcher runs as is named by one file, `tool`, beside the
# extensions folder: its name, title, id and hotkey, a key and a value on
# each line. This script spells none of them. SWOOP_TOOL names the file
# when the tool's folder is not this script's own: a tool built on the kit
# is that folder and a shim that sets SWOOP_TOOL and runs this script.
# Exported, so every program this run starts reads the same file; see
# internal/tool, which reads it in Go.
case "${SWOOP_TOOL:-}" in
  '') SWOOP_TOOL="$here/../tool" ;;
  /*|[A-Za-z]:[\\/]*) ;;
  *) SWOOP_TOOL="$PWD/$SWOOP_TOOL" ;;
esac
export SWOOP_TOOL
root="${SWOOP_TOOL%[\\/]*}"
# The extensions bundled with the tool, next to the user's own in
# ~/.config/<name>/extensions. The user's win when names collide.
export SWOOP_EXTENSIONS="$root/extensions${SWOOP_EXTENSIONS:+:$SWOOP_EXTENSIONS}"

# Reads the file into tool_name, tool_title, tool_id and tool_hotkey, with
# what it leaves out filled in: no name is the kit's own prefix, no title
# is the name, no id is dev.<name>. A name or an id that is not one plain
# word is skipped, with a note: both end up in paths and labels. The same
# rules as internal/tool, and a test there holds the two together.
swoop_tool() {
  local LC_ALL=C k v
  tool_name="" tool_title="" tool_id="" tool_hotkey=""
  if [ -f "$SWOOP_TOOL" ] && [ "$(wc -c < "$SWOOP_TOOL")" -le 4096 ]; then
    while read -r k v || [ -n "$k" ]; do
      # A file written on Windows ends its lines with a carriage return.
      k="${k%$'\r'}"; v="${v%$'\r'}"
      v="${v%"${v##*[![:space:]]}"}"
      case "$k" in
        name|id|hotkey)
          case "$v" in
            ''|[!A-Za-z0-9]*|*[!A-Za-z0-9._+-]*)
              echo "tool: $k \"$v\" is not one plain word (letters, digits, . _ - +); skipped" >&2
              continue ;;
          esac ;;
      esac
      case "$k" in
        name) tool_name="$v" ;;
        title) tool_title="$v" ;;
        id) tool_id="$v" ;;
        hotkey) tool_hotkey="$v" ;;
      esac
    done < "$SWOOP_TOOL"
  fi
  [ -n "$tool_name" ] || tool_name=swoop
  [ -n "$tool_title" ] || tool_title="$tool_name"
  [ -n "$tool_id" ] || tool_id="dev.$tool_name"
  [ -n "$tool_hotkey" ] || tool_hotkey="alt+shift+space"
}
# Read once, for the verbs below and for the extensions: SWOOP_TOOL_NAME
# is the tool's name, the word in its folders, so an extension that keeps
# a file of its own puts it under ~/.local/share/<name> or
# ~/.local/state/<name> with no reader of the tool file in it. A script
# cannot ask internal/tool, and asking this launcher would be a second
# bash on a cursor move. Always the file's: a name left in the
# environment by another tool's launcher does not carry over.
swoop_tool
export SWOOP_TOOL_NAME="$tool_name"

# <name> start|stop|restart|status: the frame's service, whichever way it
# was installed, so nobody has to remember brew services or launchctl.
# They run before fzf, so `<name> restart` never opens the launcher. Any
# other argument, or none, opens the launcher as always.
#
#   Homebrew   the running frame's path is under a Homebrew prefix, or
#              `brew services list` names the tool: brew services does it
#   launchd    the curl installer or a checkout, ~/Library/LaunchAgents/
#              <id>.shell.plist exists: launchctl on <id>.shell and
#              <id>.clipd
#
# A tool made by `<name> new` has no installer: its folder holds a tool
# file and a command, and the programs are the kit's, somewhere else. For
# that tool `start` is the installer. It gives the tool a frame of its own
# and writes its two agents, through the kit's scripts/launchd.sh, and
# `restart` does it again, so the frame is the kit's newest. Its frame
# runs beside the frame of any other tool: each has its own process, its
# own key, its own folders and its own Accessibility entry.
#
# <name> tool [key] prints what the file says, filled in: every line, or
# the one value. It is how the frame and the scripts learn the tool's
# name without a parser of their own.
#
# <name> new <tool> makes a tool of one's own: a folder called <tool>,
# here, copied from the kit's templates/tool. See swoop_new.
#
# Written for the bash macOS ships, 3.2: no arrays under set -u, no
# readlink -f.
swoop_service() {
  local verb="$1" domain agents kit own launcher toolfile pid path how label plist
  case "$(uname -s)" in
    Darwin) ;;
    *) echo "$tool_name $verb: there is no frame on this OS yet; run $tool_name in a terminal" >&2; return 1 ;;
  esac
  domain="gui/$(id -u)"
  agents="$HOME/Library/LaunchAgents"
  kit="${here%/*}"
  # Which processes are a tool's, and how its agents are written, is the
  # kit's scripts/launchd.sh. A kit copied without it still stops and
  # starts a service; it cannot find a frame started by hand, or install.
  # shellcheck source=scripts/launchd.sh
  [ ! -f "$kit/scripts/launchd.sh" ] || . "$kit/scripts/launchd.sh"

  # The command this tool is run by, which is what its frame runs. The
  # kit's own tool, the one whose file is beside this bin/, is run by
  # this script. A tool with its folder elsewhere is run by its own
  # command, bin/<name> beside its tool file, as `new` makes it.
  own=""
  if [ "$SWOOP_TOOL" = "$here/../tool" ] || [ "$SWOOP_TOOL" -ef "$here/../tool" ]; then
    own=1
    launcher="$here/swoop"
    toolfile=""
  else
    toolfile="$(cd -P "$root" 2>/dev/null && pwd)" || toolfile="$root"
    launcher="$toolfile/bin/$tool_name"
    toolfile="$toolfile/${SWOOP_TOOL##*[\\/]}"
  fi

  # This tool's frame, and no other tool's: every tool's frame is the
  # same program, so its name says nothing. The frame is the one launchd
  # runs under this tool's label, ours or Homebrew's, or else one started
  # by hand that runs this tool's launcher.
  pid="$(_swoop_service_pid "$tool_id.shell")"
  [ -n "$pid" ] || pid="$(_swoop_service_pid "homebrew.mxcl.$tool_name")"
  if [ -z "$pid" ] && type swoop_frames >/dev/null 2>&1; then
    pid="$(swoop_frames "$launcher" swoop-shell-mac | head -1)"
  fi
  path=""
  [ -z "$pid" ] || path="$(ps -o comm= -p "$pid" 2>/dev/null)"

  # The running frame knows best where it came from. When none runs, a
  # plist of ours is firmer evidence than brew's list, which names the tool
  # on any Mac that has the formula, used or not.
  how=""
  # Only the kit's own tool: a tool with its folder elsewhere may run a
  # frame by hand from a kit that Homebrew installed, and brew has no
  # service of that tool's name.
  [ -z "$own" ] || case "$path" in
    */Cellar/*|/opt/homebrew/*|/home/linuxbrew/*) how=homebrew ;;
  esac
  [ -n "$how" ] || [ ! -f "$agents/$tool_id.shell.plist" ] || how=launchd
  if [ -z "$how" ] && command -v brew >/dev/null 2>&1 &&
    brew services list 2>/dev/null | awk -v n="$tool_name" '$1 == n { f = 1 } END { exit !f }'; then
    how=homebrew
  fi

  if [ "$verb" = status ]; then
    _swoop_status "$how" "$pid" "$path"
    [ -n "$how" ] || { _swoop_not_installed; return 1; }
    return 0
  fi
  # A tool with no installer of its own: start installs, when its frame's
  # service is not loaded, and restart installs again. Stop is the same
  # for every tool.
  if [ -z "$own" ] && [ "$how" != homebrew ]; then
    case "$verb" in
      restart) _swoop_install; return ;;
      start)
        if ! launchctl print "$domain/$tool_id.shell" >/dev/null 2>&1; then
          _swoop_install; return
        fi ;;
    esac
  fi
  case "$how" in
    homebrew)
      # The clipboard watcher is no service under Homebrew: the launcher
      # starts it the first time it runs, and it keeps running.
      brew services "$verb" "$tool_name" ;;
    launchd)
      # The watcher first, so the frame's first launcher finds it running.
      # Stop goes the other way: the frame, then the watcher.
      local labels="$tool_id.clipd $tool_id.shell"
      [ "$verb" = stop ] && labels="$tool_id.shell $tool_id.clipd"
      for label in $labels; do
        plist="$agents/$label.plist"
        # An install older than the watcher's agent has only the frame's.
        [ -f "$plist" ] || continue
        if launchctl print "$domain/$label" >/dev/null 2>&1; then
          case "$verb" in
            start) echo "$label is already running" ;;
            stop) launchctl bootout "$domain/$label" || return 1; echo "stopped $label" ;;
            # -k kills the running one first; KeepAlive would bring it
            # back anyway, but kickstart does it now and waits.
            restart) launchctl kickstart -k "$domain/$label" || return 1; echo "restarted $label" ;;
          esac
        else
          case "$verb" in
            stop) echo "$label is not running" ;;
            *) launchctl bootstrap "$domain" "$plist" || return 1; echo "started $label" ;;
          esac
        fi
      done ;;
    *)
      _swoop_not_installed
      return 1 ;;
  esac
}

# The process launchd runs under a label, or nothing when the label is
# not loaded or has no process now. Reads domain from the caller.
_swoop_service_pid() { # label
  launchctl print "$domain/$1" 2>/dev/null | sed -n 's/^[[:space:]]*pid = \([0-9][0-9]*\)$/\1/p' | head -1
}

# The frame and the two agents of a tool that runs the kit's programs
# from a folder of its own. Reads kit, launcher, toolfile and verb from
# swoop_service, which calls it.
_swoop_install() {
  local src frame
  if [ ! -x "$launcher" ]; then
    echo "$tool_name $verb: there is no command at $launcher. The frame runs the tool's own command: bin/$tool_name beside its tool file, as \`new\` makes it" >&2
    return 1
  fi
  # The kit's frame: beside this script in a release and under Homebrew,
  # where swift left it in a checkout.
  src="$here/swoop-shell-mac"
  [ -x "$src" ] || src="$kit/shell/mac/.build/release/swoop-shell-mac"
  if [ ! -x "$src" ]; then
    echo "$tool_name $verb: the kit in $kit has no frame. A release for the Mac has one; in a checkout, \`make shell-mac\` builds it" >&2
    return 1
  fi
  if [ ! -x "$here/swoop-clipd" ]; then
    echo "$tool_name $verb: the kit in $kit has no clipboard watcher. In a checkout, \`make build\` builds the kit's programs" >&2
    return 1
  fi
  if ! type swoop_launchd >/dev/null 2>&1; then
    echo "$tool_name $verb: the kit in $kit has no scripts/launchd.sh, which writes the agents" >&2
    return 1
  fi
  frame="$(swoop_own_frame "$src" "$tool_name" "$tool_id")" || return 1
  swoop_launchd "$kit" "$frame" "$launcher" "$toolfile" || return 1
  cat <<MSG

$tool_title is installed. Press $(_swoop_hotkey).
It starts again at login. Logs: $HOME/Library/Logs/$tool_name.
$tool_name stop, $tool_name restart and $tool_name status look after it.
To macOS its frame is a program of its own, $frame:
a paste asks for Accessibility for that one, once.
MSG
}

# Reads own from swoop_service.
_swoop_not_installed() {
  if [ -z "$own" ]; then
    cat >&2 <<MSG
$tool_name: the frame is not installed. On a Mac, install it with:
  $tool_name start
MSG
    return 0
  fi
  cat >&2 <<MSG
$tool_name: the frame is not installed. Install it one of these ways:
  brew install beatzball/tap/$tool_name && brew services start $tool_name
  curl -fsSL https://raw.githubusercontent.com/beatzball/swoop/main/scripts/get | bash
  make install, from a checkout
MSG
}

# The key that opens the frame, in the frame's own order: SWOOP_HOTKEY in
# its environment, which is its plist's, then the config file, then the
# tool's own. See shell/mac Config.hotkey. Reads agents from the caller.
_swoop_hotkey() {
  local hotkey="" plist="$agents/$tool_id.shell.plist"
  [ ! -f "$plist" ] || hotkey="$(sed -n 's:.*<key>SWOOP_HOTKEY</key><string>\(.*\)</string>.*:\1:p' "$plist")"
  [ -n "$hotkey" ] || hotkey="$(awk -F= '
    /^[ \t]*#/ { next }
    { k = $1; gsub(/[ \t]/, "", k) }
    k == "hotkey" { v = substr($0, index($0, "=") + 1); gsub(/^[ \t]+|[ \t]+$/, "", v) }
    END { print v }' "${XDG_CONFIG_HOME:-$HOME/.config}/$tool_name/config" 2>/dev/null)"
  [ -n "$hotkey" ] || hotkey="$tool_hotkey"
  echo "$hotkey"
}

# One line for the frame, one for the watcher. Reads agents and here from
# the caller.
_swoop_status() { # how pid path
  local how="$1" pid="$2" path="$3" hotkey version="?" plist wpid wpath
  plist="$agents/$tool_id.shell.plist"
  hotkey="$(_swoop_hotkey)"
  [ ! -f "$root/VERSION" ] || version="$(tr -d '[:space:]' < "$root/VERSION")"
  # Where the frame is when it is not running: what its plist would run,
  # or the one beside this script, as a release and Homebrew keep it.
  if [ -z "$path" ]; then
    [ ! -f "$plist" ] || path="$(sed -n '/<key>ProgramArguments<\/key>/,/<\/array>/s:.*<string>\(.*\)</string>.*:\1:p' "$plist" | head -1)"
    [ -n "$path" ] || [ ! -x "$here/swoop-shell-mac" ] || path="$here/swoop-shell-mac"
  fi
  if [ -n "$pid" ]; then
    echo "frame:   running, pid $pid, hotkey $hotkey, version $version, ${path:-?}, installed by ${how:-hand}"
  else
    echo "frame:   not running, hotkey $hotkey, version $version, ${path:-?}, installed by ${how:-nothing}"
  fi
  # This tool's watcher: the one that holds the lock in the tool's own
  # folder. A watcher too old to say which process it is still holds it.
  wpid="$(swoop-clipd pid 2>/dev/null)" || wpid=""
  if [ -n "$wpid" ]; then
    wpath="$(ps -o comm= -p "$wpid" 2>/dev/null)"
    echo "watcher: running, pid $wpid, ${wpath:-?}"
  elif swoop-clipd status >/dev/null 2>&1; then
    echo "watcher: running, pid not known: it is from an older version"
  else
    echo "watcher: not running, $here/swoop-clipd"
  fi
}

# new <tool>: a tool of one's own, as a folder of that name in the current
# directory. The files are the kit's templates/tool, beside bin/ and not
# beside the tool file: a template is the kit's, whichever tool asks.
# Every file there is copied, with @NAME@ in its path and in its text
# replaced by the name, so a file added to the template needs no change
# here. Nothing is written over: a folder or file of that name already
# here stops it.
swoop_new() {
  local LC_ALL=C name="${1:-}" tpl="$here/../templates/tool" f to
  case "$name" in
    '') echo "usage: $tool_name new <name>" >&2; return 2 ;;
    [!A-Za-z0-9]*|*[!A-Za-z0-9._+-]*)
      echo "new: \"$name\" is not one plain word (letters, digits, . _ - +)" >&2; return 2 ;;
    # The command would be bin/<name>, and a link to it on PATH would
    # answer for one of the kit's own programs.
    swoop|swoop-*)
      echo "new: $name is one of the kit's own programs; pick another name" >&2; return 2 ;;
  esac
  [ -f "$tpl/tool" ] || { echo "new: no template at $tpl" >&2; return 1; }
  if [ -e "$name" ] || [ -L "$name" ]; then
    echo "new: $name is already here; nothing was changed" >&2; return 1
  fi
  echo "made $name/"
  while IFS= read -r f; do
    f="${f#./}"
    to="$name/${f//@NAME@/$name}"
    # Said and stopped at the first file that cannot be written: the
    # caller's `||` turns errexit off in here.
    if ! mkdir -p "$(dirname "$to")" || ! sed "s/@NAME@/$name/g" "$tpl/$f" > "$to"; then
      echo "new: could not write $to" >&2; return 1
    fi
    [ ! -x "$tpl/$f" ] || chmod +x "$to"
    echo "  ${to#"$name"/}"
  done < <(cd "$tpl" && find . -type f ! -name .DS_Store | sort)
  cat <<MSG

Run it in this terminal; Esc quits:
  $name/bin/$name
On a Mac, give it the frame, a panel on a key of its own:
  $name/bin/$name start
MSG
  # The command runs the kit's launcher by name. PATH here starts with
  # this script's own folder, which the person's shell may not have.
  if ! PATH="${PATH#"$here":}" command -v swoop >/dev/null 2>&1; then
    cat <<MSG
It runs swoop, the kit's launcher, which is not on your PATH. Until it is:
  PATH="$here:\$PATH" $name/bin/$name
  PATH="$here:\$PATH" $name/bin/$name start
MSG
  fi
  cat <<MSG

Its rows come from $name/extensions; $name/tool has its name, title, id
and hotkey. $name/README.md says how to change both, and has the rest
about the frame.
MSG
}

case "${1:-}" in
  new)
    swoop_new "${2:-}" || status=$?
    exit "$status" ;;
  tool)
    case "${2:-}" in
      '') printf 'name %s\ntitle %s\nid %s\nhotkey %s\n' "$tool_name" "$tool_title" "$tool_id" "$tool_hotkey" ;;
      name) echo "$tool_name" ;;
      title) echo "$tool_title" ;;
      id) echo "$tool_id" ;;
      hotkey) echo "$tool_hotkey" ;;
      *) echo "tool: no such key: $2; it is one of name, title, id, hotkey" >&2; exit 2 ;;
    esac
    exit 0 ;;
  keys)
    # The keys the extensions claim; `keys for <extension>` is the one key
    # that opens that extension's pane, or no line. The frame asks this
    # for its menu's Settings item: it has no list of extensions and no
    # key of its own, and only this script knows where the extensions are.
    shift
    exec swoop-nav keys "$@" ;;
  start|stop|restart|status)
    swoop_service "$1" || status=$?
    # Which extension has which key, and any claim that lost.
    [ "$1" != status ] || swoop-nav keys status || true
    # The lists that missed their limit the last time a start was slow.
    [ "$1" != status ] || swoop-nav late || true
    exit "$status" ;;
esac

# The line is: id, kind, icon, title, subtitle, tab-separated.
#   --with-nth   a template: show "icon title", then a tab, then the subtitle;
#                the id and kind stay hidden. {1} in the enter binding is still
#                the ORIGINAL first field, the id: placeholders read the input
#                line, only --nth reads the transformed one
#   --nth 1      match on field 1 of the TRANSFORMED line, "icon title", never
#                on the subtitle, so typing "doc" does not match every row
#                that lives under ~/Documents
#   --tabstop 1  the one tab left in the row is a 1-column gap, not a jump to
#                the next 8-column stop, so subtitles line up after the title
#   --tiebreak   prefer matches at the start, then shorter titles, so typing
#                "saf" puts Safari above "Safari Technology Preview"; then
#                the row's place, so a recent row stays ahead of an equal
#                match below it
#   left-click:  a click on a row is Enter on that row. fzf moves the
#                cursor to the clicked row before it runs the binding, so
#                {1} is the row under the mouse
#                A click on a header puts the cursor back where it was,
#                which is why it is swoop-nav click and not enter
#   up, down, ctrl-p, ctrl-n, ctrl-j, page-up, page-down, the wheel:
#                every key that moves the cursor does the move and then
#                asks swoop-nav step about the row it came to: a header,
#                kind group, is stepped over, the same way. {2} is filled
#                in when the transform runs, after the move. See nav.Step
#   ctrl-u, ctrl-d:
#                scroll the preview half a page, the way preen and the
#                usual terminal tools do. fzf's own ctrl-u clears the bar,
#                which Esc does here anyway
#   --preview-window:
#                from swoop-nav, which reads the width the user last chose
#                from ~/.config/<name>/config; 58% to start with. nav builds
#                the same string for the panes that change the window
#   alt-left, alt-right:
#                move the divider: alt-left gives the preview 5% more,
#                alt-right gives the list 5% more, and the width is
#                remembered. cmd+[ and cmd+] in the frame are these keys
#   ctrl-k:      the row's actions as a pane of their own; cmd+K in the
#                frame is mapped to it. fzf's own ctrl-k is "up", which the
#                arrow key still does
#   "$@":        the keys the extensions claim, each in a `key` file beside
#                its program: the key opens that extension's view, as
#                Enter on its row would. This script names none of them;
#                swoop-nav keys lists them, and swoop-nav key decides who
#                has the key when it is pressed
#   start:       sends the pictures for the rows, once, and unbinds
#                result-final. After a start where a list missed its
#                limit it also lists again; see $again below
#   --listen:    fzf's HTTP API on a socket of this run's own, so a worker
#                an extension leaves running can tell fzf to redraw the
#                preview or list again. The key keeps anything else out
#   enter, esc, change:
#                all three go through swoop-nav, which prints the actions:
#                Enter runs a row or opens a view; Esc clears the bar,
#                then pops a view, then closes; typing inside a view asks
#                the extension for new rows; typing at the root asks the
#                extensions with the text while fzf matches the rows
#                kept for the run
#   wait+:       at the head of every key that reads the row under the
#                cursor (Enter, a click, ctrl-k, a claimed key): the key is
#                held until the list in flight has landed, so a second
#                quick Enter ticks the next task, not the one just ticked.
#                No chain waits; see nav.LandEvent in internal/nav
#   result-final:
#                places the cursor once a pop's or a send's list lands,
#                and moves it off a header. Unbound at start; a chain
#                that needs it rebinds it, and swoop-nav landed unbinds it
#                again outside a view, so it costs nothing on a keystroke
#                at the root
icons="$(mktemp "${TMPDIR:-/tmp}/swoop-icons.XXXXXX")"
rows="$(mktemp "${TMPDIR:-/tmp}/swoop-rows.XXXXXX")"
# Where swoop-nav keeps the stack of panes for this run. Enter, Esc, and
# typing all go through swoop-nav, which prints the fzf actions to take;
# see internal/nav for the rules. The file is removed on exit, and by the
# run command itself when Enter replaces fzf.
SWOOP_STATE="$(mktemp "${TMPDIR:-/tmp}/swoop-state.XXXXXX")"
export SWOOP_STATE
# Where a terminal row's run may write a row id to come back on, with the
# bar cleared: New note names the note it made. See nav.Back.
SWOOP_LAND="$SWOOP_STATE.land"
export SWOOP_LAND
# The rows of the extensions that ask to be listed once per launch, with a
# file named "cache" beside them, pictures attached. The first swoop-nav
# rows fills it; every reload at the root reads it and asks only the other
# extensions again, with the text in the bar: that is how a calculator row
# appears while you type.
SWOOP_ONCE="$SWOOP_STATE.once"
export SWOOP_ONCE
# fzf's API, for an extension's worker: a Unix socket beside the state file,
# which fzf exports to its children as FZF_SOCK, or a localhost port on
# Windows, exported as FZF_PORT. Requests need the key.
sock="$SWOOP_STATE.sock"
listen="$sock"
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) listen=0 ;;
esac
# A key already in the environment is kept: that is how a test drives
# this fzf.
: "${FZF_API_KEY:=$(head -c 24 /dev/urandom | base64)}"
export FZF_API_KEY
# The clipboard watcher outlives the launcher; start it if none runs. It
# is the one part that runs while the launcher is closed.
# SWOOP_NO_CLIPD=1 skips it: a test, or a machine where you would rather
# not have it.
[ -n "${SWOOP_NO_CLIPD:-}" ] || swoop-clipd start || true
# SWOOP_ICONS is where the pictures for those rows go, for the start
# binding below to send. Only this first call is told: the terminal takes
# the pictures once.
SWOOP_ICONS="$icons" swoop-nav rows > "$rows"
# A list that missed its limit in that call left a file beside the once
# file: the first run of programs new on the machine, mostly, after an
# install or an update, when the system checks each one. Its rows are not
# in the list fzf starts with. So fzf asks again as it starts, with no key
# pressed, and they fill themselves in. On every other start this is one
# test of a name and no process.
again=""
if [ -e "$SWOOP_ONCE.late" ]; then
  rm -f "$SWOOP_ONCE.late"
  again="+reload(swoop-nav rows)"
fi
# One binding for each key an extension claims. They go in the positional
# parameters, which this script does not read past this point: an empty
# "$@" is safe under set -u in the bash macOS ships, and an empty array is
# not. A key's name is one of a short list with nothing in it a shell or a
# binding reads as its own (ext.ValidKey), so it goes in as it is.
set --
while IFS= read -r key; do
  [ -z "$key" ] || set -- "$@" --bind "$key:wait+transform:swoop-nav key $key"
done < <(swoop-nav keys)
fzf < "$rows" \
  --ansi \
  --bind "start:execute-silent(cat '$icons' > /dev/tty; rm -f '$icons' '$rows')+unbind(result-final)$again" \
  --delimiter $'\t' \
  --with-nth $'{3} {4}  \t{5}' \
  --nth 1 \
  --tabstop 1 \
  --tiebreak 'begin,length,index' \
  --layout reverse \
  --no-info \
  --prompt '  ' \
  --pointer '▶' \
  --preview 'swoop-preview {1}' \
  --preview-window "$(swoop-nav window)" \
  --bind 'alt-left:transform:swoop-nav divider +5' \
  --bind 'alt-right:transform:swoop-nav divider -5' \
  --bind 'ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down' \
  --bind 'enter:wait+transform:swoop-nav enter {1} {2} {4}' \
  --bind 'left-click:wait+transform:swoop-nav click {1} {2} {4}' \
  --bind 'up:up+transform:swoop-nav step up {2}' \
  --bind 'ctrl-p:up+transform:swoop-nav step up {2}' \
  --bind 'scroll-up:up+transform:swoop-nav step up {2}' \
  --bind 'page-up:page-up+transform:swoop-nav step up {2}' \
  --bind 'down:down+transform:swoop-nav step down {2}' \
  --bind 'ctrl-n:down+transform:swoop-nav step down {2}' \
  --bind 'ctrl-j:down+transform:swoop-nav step down {2}' \
  --bind 'scroll-down:down+transform:swoop-nav step down {2}' \
  --bind 'page-down:page-down+transform:swoop-nav step down {2}' \
  --bind 'ctrl-k:wait+transform:swoop-nav actions {1} {2} {4}' \
  "$@" \
  --bind 'result-final:transform:swoop-nav landed {2}' \
  --listen "$listen" \
  --bind 'esc:transform:swoop-nav esc' \
  --bind 'change:transform:swoop-nav change' || status=$?
rm -f "$icons" "$rows" "$SWOOP_STATE" "$SWOOP_LAND" "$SWOOP_ONCE" "$sock"
# Inside a frame of our own, tell it we are leaving, so it can put the
# panel away before the terminal prints "Process exited".
[ -n "${SWOOP_SHELL_PID:-}" ] && kill -USR2 "$SWOOP_SHELL_PID" 2>/dev/null
# Esc and ctrl-c make fzf exit 130. Closing the launcher is not a failure,
# and Ghostty treats a fast non-zero exit as one: it keeps the pane open
# with "Process exited" until a key is pressed. Anything else is real.
[ "$status" -eq 130 ] && status=0
exit "$status"
