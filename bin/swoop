#!/usr/bin/env bash
# swoop: the launcher, as one fzf call. Runs in any terminal on any OS.
#
# The extensions print result lines; fzf shows and filters them; Enter hands
# the picked id to swoop-run, which replaces fzf (become) so nothing is left
# running. The built binaries live beside this script, in bin/, which is why
# it is the one tracked file there (see .gitignore).
set -euo pipefail
status=0

# The tools are found by this script's own directory, not by PATH alone, so
# a stale swoop-nav elsewhere on PATH never answers for ours. Follow
# symlinks first: scripts/get links ~/.local/bin/swoop to this file, and the
# tools are beside the file, not beside the link. A loop rather than
# readlink -f, which the bash and readlink of older macOS do not have.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  link="$(readlink "$src")"
  case "$link" in
    /*) src="$link" ;;
    *) src="$(dirname "$src")/$link" ;;
  esac
done
here="$(cd -P "$(dirname "$src")" && pwd)"
export PATH="$here:$PATH"
# The extensions bundled in the repository, next to the user's own in
# ~/.config/swoop/extensions. The user's win when names collide.
export SWOOP_EXTENSIONS="$here/../extensions${SWOOP_EXTENSIONS:+:$SWOOP_EXTENSIONS}"

# swoop start|stop|restart|status: the frame's service, whichever way it
# was installed, so nobody has to remember brew services or launchctl.
# They run before fzf, so `swoop restart` never opens the launcher. Any
# other argument, or none, opens the launcher as always.
#
#   Homebrew   the running frame's path is under a Homebrew prefix, or
#              `brew services list` names swoop: brew services does it
#   launchd    the curl installer or a checkout, ~/Library/LaunchAgents/
#              dev.swoop.shell.plist exists: launchctl on dev.swoop.shell
#              and dev.swoop.clipd
#
# Written for the bash macOS ships, 3.2: no arrays under set -u, no
# readlink -f.
swoop_service() {
  local verb="$1" domain agents pid path how label plist
  case "$(uname -s)" in
    Darwin) ;;
    *) echo "swoop $verb: there is no frame on this OS yet; run swoop in a terminal" >&2; return 1 ;;
  esac
  domain="gui/$(id -u)"
  agents="$HOME/Library/LaunchAgents"
  pid="$(pgrep -x swoop-shell-mac 2>/dev/null | head -1)"
  path=""
  [ -z "$pid" ] || path="$(ps -o comm= -p "$pid" 2>/dev/null)"

  # The running frame knows best where it came from. When none runs, a
  # plist of ours is firmer evidence than brew's list, which names swoop
  # on any Mac that has the formula, used or not.
  how=""
  case "$path" in
    */Cellar/*|/opt/homebrew/*|/home/linuxbrew/*) how=homebrew ;;
  esac
  [ -n "$how" ] || [ ! -f "$agents/dev.swoop.shell.plist" ] || how=launchd
  if [ -z "$how" ] && command -v brew >/dev/null 2>&1 &&
    brew services list 2>/dev/null | awk '$1 == "swoop" { f = 1 } END { exit !f }'; then
    how=homebrew
  fi

  if [ "$verb" = status ]; then
    _swoop_status "$how" "$pid" "$path"
    [ -n "$how" ] || { _swoop_not_installed; return 1; }
    return 0
  fi
  case "$how" in
    homebrew)
      # The clipboard watcher is no service under Homebrew: the launcher
      # starts it the first time it runs, and it keeps running.
      brew services "$verb" swoop ;;
    launchd)
      # The watcher first, so the frame's first swoop finds it running.
      # Stop goes the other way: the frame, then the watcher.
      local labels="dev.swoop.clipd dev.swoop.shell"
      [ "$verb" = stop ] && labels="dev.swoop.shell dev.swoop.clipd"
      for label in $labels; do
        plist="$agents/$label.plist"
        # An install older than the watcher's agent has only the frame's.
        [ -f "$plist" ] || continue
        if launchctl print "$domain/$label" >/dev/null 2>&1; then
          case "$verb" in
            start) echo "$label is already running" ;;
            stop) launchctl bootout "$domain/$label" || return 1; echo "stopped $label" ;;
            # -k kills the running one first; KeepAlive would bring it
            # back anyway, but kickstart does it now and waits.
            restart) launchctl kickstart -k "$domain/$label" || return 1; echo "restarted $label" ;;
          esac
        else
          case "$verb" in
            stop) echo "$label is not running" ;;
            *) launchctl bootstrap "$domain" "$plist" || return 1; echo "started $label" ;;
          esac
        fi
      done ;;
    *)
      _swoop_not_installed
      return 1 ;;
  esac
}

_swoop_not_installed() {
  cat >&2 <<'MSG'
swoop: the frame is not installed. Install it one of these ways:
  brew install beatzball/tap/swoop && brew services start swoop
  curl -fsSL https://raw.githubusercontent.com/beatzball/swoop/main/scripts/get | bash
  make install, from a checkout
MSG
}

# One line for the frame, one for the watcher. Reads agents and here from
# the caller.
_swoop_status() { # how pid path
  local how="$1" pid="$2" path="$3" hotkey="" version="?" plist wpid wpath
  plist="$agents/dev.swoop.shell.plist"
  # The frame's own order: SWOOP_HOTKEY in its environment, then the
  # config file, then the default. See shell/mac Config.hotkey.
  [ ! -f "$plist" ] || hotkey="$(sed -n 's:.*<key>SWOOP_HOTKEY</key><string>\(.*\)</string>.*:\1:p' "$plist")"
  [ -n "$hotkey" ] || hotkey="$(awk -F= '
    /^[ \t]*#/ { next }
    { k = $1; gsub(/[ \t]/, "", k) }
    k == "hotkey" { v = substr($0, index($0, "=") + 1); gsub(/^[ \t]+|[ \t]+$/, "", v) }
    END { print v }' "${XDG_CONFIG_HOME:-$HOME/.config}/swoop/config" 2>/dev/null)"
  [ -n "$hotkey" ] || hotkey="alt+shift+space"
  [ ! -f "$here/../VERSION" ] || version="$(tr -d '[:space:]' < "$here/../VERSION")"
  # Where the frame is when it is not running: what its plist would run,
  # or the one beside this script, as a release and Homebrew keep it.
  if [ -z "$path" ]; then
    [ ! -f "$plist" ] || path="$(sed -n '/<key>ProgramArguments<\/key>/,/<\/array>/s:.*<string>\(.*\)</string>.*:\1:p' "$plist" | head -1)"
    [ -n "$path" ] || [ ! -x "$here/swoop-shell-mac" ] || path="$here/swoop-shell-mac"
  fi
  if [ -n "$pid" ]; then
    echo "frame:   running, pid $pid, hotkey $hotkey, version $version, ${path:-?}, installed by ${how:-hand}"
  else
    echo "frame:   not running, hotkey $hotkey, version $version, ${path:-?}, installed by ${how:-nothing}"
  fi
  wpid="$(pgrep -f 'swoop-clipd run' 2>/dev/null | head -1)"
  if [ -n "$wpid" ]; then
    wpath="$(ps -o comm= -p "$wpid" 2>/dev/null)"
    echo "watcher: running, pid $wpid, ${wpath:-?}"
  else
    echo "watcher: not running, $here/swoop-clipd"
  fi
}

case "${1:-}" in
  start|stop|restart|status)
    swoop_service "$1" || status=$?
    # Which extension has which key, and any claim that lost.
    [ "$1" != status ] || swoop-nav keys status || true
    exit "$status" ;;
esac

# The line is: id, kind, icon, title, subtitle, tab-separated.
#   --with-nth   a template: show "icon title", then a tab, then the subtitle;
#                the id and kind stay hidden. {1} in the enter binding is still
#                the ORIGINAL first field, the id: placeholders read the input
#                line, only --nth reads the transformed one
#   --nth 1      match on field 1 of the TRANSFORMED line, "icon title", never
#                on the subtitle, so typing "doc" does not match every row
#                that lives under ~/Documents
#   --tabstop 1  the one tab left in the row is a 1-column gap, not a jump to
#                the next 8-column stop, so subtitles line up after the title
#   --tiebreak   prefer matches at the start, then shorter titles, so typing
#                "saf" puts Safari above "Safari Technology Preview"; then
#                the row's place, so a recent row stays ahead of an equal
#                match below it
#   left-click:  a click on a row is Enter on that row. fzf moves the
#                cursor to the clicked row before it runs the binding, so
#                {1} is the row under the mouse
#                A click on a header puts the cursor back where it was,
#                which is why it is swoop-nav click and not enter
#   up, down, ctrl-p, ctrl-n, ctrl-j, page-up, page-down, the wheel:
#                every key that moves the cursor does the move and then
#                asks swoop-nav step about the row it came to: a header,
#                kind group, is stepped over, the same way. {2} is filled
#                in when the transform runs, after the move. See nav.Step
#   ctrl-u, ctrl-d:
#                scroll the preview half a page, the way preen and the
#                usual terminal tools do. fzf's own ctrl-u clears the bar,
#                which Esc does here anyway
#   --preview-window:
#                from swoop-nav, which reads the width the user last chose
#                from ~/.config/swoop/config; 58% to start with. nav builds
#                the same string for the panes that change the window
#   alt-left, alt-right:
#                move the divider: alt-left gives the preview 5% more,
#                alt-right gives the list 5% more, and the width is
#                remembered. cmd+[ and cmd+] in the frame are these keys
#   ctrl-k:      the row's actions as a pane of their own; cmd+K in the
#                frame is mapped to it. fzf's own ctrl-k is "up", which the
#                arrow key still does
#   "$@":        the keys the extensions claim, each in a `key` file beside
#                its program: the key opens that extension's view, as
#                Enter on its row would. This script names none of them;
#                swoop-nav keys lists them, and swoop-nav key decides who
#                has the key when it is pressed
#   --listen:    fzf's HTTP API on a socket of this run's own, so a worker
#                an extension leaves running can tell fzf to redraw the
#                preview or list again. The key keeps anything else out
#   enter, esc, change:
#                all three go through swoop-nav, which prints the actions:
#                Enter runs a row or opens a view; Esc clears the bar,
#                then pops a view, then closes; typing inside a view asks
#                the extension for new rows; typing at the root asks the
#                extensions with the text while fzf matches the rows
#                kept for the run
#   wait+:       at the head of every key that reads the row under the
#                cursor (Enter, a click, ctrl-k, a claimed key): the key is
#                held until the list in flight has landed, so a second
#                quick Enter ticks the next task, not the one just ticked.
#                No chain waits; see nav.LandEvent in internal/nav
#   result-final:
#                places the cursor once a pop's or a send's list lands,
#                and moves it off a header. Unbound at start; a chain
#                that needs it rebinds it, and swoop-nav landed unbinds it
#                again outside a view, so it costs nothing on a keystroke
#                at the root
icons="$(mktemp "${TMPDIR:-/tmp}/swoop-icons.XXXXXX")"
rows="$(mktemp "${TMPDIR:-/tmp}/swoop-rows.XXXXXX")"
# Where swoop-nav keeps the stack of panes for this run. Enter, Esc, and
# typing all go through swoop-nav, which prints the fzf actions to take;
# see internal/nav for the rules. The file is removed on exit, and by the
# run command itself when Enter replaces fzf.
SWOOP_STATE="$(mktemp "${TMPDIR:-/tmp}/swoop-state.XXXXXX")"
export SWOOP_STATE
# Where a terminal row's run may write a row id to come back on, with the
# bar cleared: New note names the note it made. See nav.Back.
SWOOP_LAND="$SWOOP_STATE.land"
export SWOOP_LAND
# The rows of the extensions that ask to be listed once per launch, with a
# file named "cache" beside them, pictures attached. The first swoop-nav
# rows fills it; every reload at the root reads it and asks only the other
# extensions again, with the text in the bar: that is how a calculator row
# appears while you type.
SWOOP_ONCE="$SWOOP_STATE.once"
export SWOOP_ONCE
# fzf's API, for an extension's worker: a Unix socket beside the state file,
# which fzf exports to its children as FZF_SOCK, or a localhost port on
# Windows, exported as FZF_PORT. Requests need the key.
sock="$SWOOP_STATE.sock"
listen="$sock"
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) listen=0 ;;
esac
# A key already in the environment is kept: that is how a test drives
# this fzf.
: "${FZF_API_KEY:=$(head -c 24 /dev/urandom | base64)}"
export FZF_API_KEY
# The clipboard watcher outlives the launcher; start it if none runs. It
# is the one part of swoop that runs while the launcher is closed.
# SWOOP_NO_CLIPD=1 skips it: a test, or a machine where you would rather
# not have it.
[ -n "${SWOOP_NO_CLIPD:-}" ] || swoop-clipd start || true
# SWOOP_ICONS is where the pictures for those rows go, for the start
# binding below to send. Only this first call is told: the terminal takes
# the pictures once.
SWOOP_ICONS="$icons" swoop-nav rows > "$rows"
# One binding for each key an extension claims. They go in the positional
# parameters, which this script does not read past this point: an empty
# "$@" is safe under set -u in the bash macOS ships, and an empty array is
# not. A key's name is one of a short list with nothing in it a shell or a
# binding reads as its own (ext.ValidKey), so it goes in as it is.
set --
while IFS= read -r key; do
  [ -z "$key" ] || set -- "$@" --bind "$key:wait+transform:swoop-nav key $key"
done < <(swoop-nav keys)
fzf < "$rows" \
  --ansi \
  --bind "start:execute-silent(cat '$icons' > /dev/tty; rm -f '$icons' '$rows')+unbind(result-final)" \
  --delimiter $'\t' \
  --with-nth $'{3} {4}  \t{5}' \
  --nth 1 \
  --tabstop 1 \
  --tiebreak 'begin,length,index' \
  --layout reverse \
  --no-info \
  --prompt '  ' \
  --pointer '▶' \
  --preview 'swoop-preview {1}' \
  --preview-window "$(swoop-nav window)" \
  --bind 'alt-left:transform:swoop-nav divider +5' \
  --bind 'alt-right:transform:swoop-nav divider -5' \
  --bind 'ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down' \
  --bind 'enter:wait+transform:swoop-nav enter {1} {2} {4}' \
  --bind 'left-click:wait+transform:swoop-nav click {1} {2} {4}' \
  --bind 'up:up+transform:swoop-nav step up {2}' \
  --bind 'ctrl-p:up+transform:swoop-nav step up {2}' \
  --bind 'scroll-up:up+transform:swoop-nav step up {2}' \
  --bind 'page-up:page-up+transform:swoop-nav step up {2}' \
  --bind 'down:down+transform:swoop-nav step down {2}' \
  --bind 'ctrl-n:down+transform:swoop-nav step down {2}' \
  --bind 'ctrl-j:down+transform:swoop-nav step down {2}' \
  --bind 'scroll-down:down+transform:swoop-nav step down {2}' \
  --bind 'page-down:page-down+transform:swoop-nav step down {2}' \
  --bind 'ctrl-k:wait+transform:swoop-nav actions {1} {2} {4}' \
  "$@" \
  --bind 'result-final:transform:swoop-nav landed {2}' \
  --listen "$listen" \
  --bind 'esc:transform:swoop-nav esc' \
  --bind 'change:transform:swoop-nav change' || status=$?
rm -f "$icons" "$rows" "$SWOOP_STATE" "$SWOOP_LAND" "$SWOOP_ONCE" "$sock"
# Inside a frame of our own, tell it we are leaving, so it can put the
# panel away before the terminal prints "Process exited".
[ -n "${SWOOP_SHELL_PID:-}" ] && kill -USR2 "$SWOOP_SHELL_PID" 2>/dev/null
# Esc and ctrl-c make fzf exit 130. Closing the launcher is not a failure,
# and Ghostty treats a fast non-zero exit as one: it keeps the pane open
# with "Process exited" until a key is pressed. Anything else is real.
[ "$status" -eq 130 ] && status=0
exit "$status"
