.DS_Store
*.log

# Go build output. Binaries are built into bin/ locally and never committed;
# bin/launtz (the fzf wiring script) is the one tracked file there.
bin/*
!bin/launtz
*.test
dist/

# Claude Code working directory: machine-specific, and none of it belongs in a
# public repo. It holds local settings (absolute paths, per-machine tool
# permissions), agent worktrees, and whatever scratch a session leaves behind.
# The whole directory, not just settings.local.json: this repo is public, and
# one `git add -A` in a session is all it would take. A global gitignore only
# protects the author's own machine; a contributor cloning this repo has no
# such protection. If a file under here ever IS worth sharing, `git add -f` it.
.claude/

# airig scratch (plans, task briefs, reports)
.airig/
