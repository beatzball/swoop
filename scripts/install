#!/usr/bin/env bash
# install: make swoop a daily driver on this Mac, from this checkout. Builds
# the tools and the frame, then hands both to scripts/launchd.sh, which
# writes two launchd agents that run at login and keep running:
#
#   dev.swoop.shell   the frame: the hotkey and the panel
#   dev.swoop.clipd   the clipboard watcher
#
# Both point at this checkout, so `make install` again after a pull or a
# rebuild restarts them on the new build. Logs go to ~/Library/Logs/swoop.
# `scripts/uninstall` removes both agents and leaves your history alone.
# scripts/get does the same from a release, with no Go and no Xcode tools.
#
# Written for the bash macOS ships, 3.2.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

case "$(uname -s)" in
  Darwin) ;;
  *) echo "install: only macOS has a frame and a watcher today" >&2; exit 1 ;;
esac
command -v fzf >/dev/null || { echo "install: fzf is not on PATH; brew install fzf" >&2; exit 1; }
command -v go >/dev/null || { echo "install: go is not on PATH" >&2; exit 1; }
command -v swift >/dev/null || { echo "install: swift is not on PATH; install Xcode or its command line tools" >&2; exit 1; }

echo "building"
make -C "$root" build shell-mac >/dev/null

# shellcheck source=scripts/launchd.sh
. "$root/scripts/launchd.sh"
# The frame stays where swift built it: its resource bundle sits beside it
# there, and the frame cannot start without that bundle.
swoop_launchd "$root" "$root/shell/mac/.build/release/swoop-shell-mac"

cat <<MSG

swoop is installed. Press ${SWOOP_HOTKEY:-alt+shift+space}.
It starts again at login. Logs: $HOME/Library/Logs/swoop. Remove it with: make uninstall
If you wired Ghostty's quick terminal to swoop in ~/.zshrc, you can take
that out now.
MSG
