#!/usr/bin/env bash
# sign-frame: sign the built frame with <name>-dev, the certificate
# scripts/codesign-identity makes, under the identifier <id>.shell. The
# name and the id are the tool's, from the file `tool`, which the launcher
# reads. `make shell-mac` runs it on every build.
#
#   scripts/sign-frame FRAME
#
# With one certificate and one identifier, macOS sees every build as the
# same program, and an Accessibility grant survives a rebuild. Without
# <name>-dev (CI, or a Mac that never ran the installer) the frame keeps
# the ad-hoc signature the linker gave it, as before.
#
# Written for the bash macOS ships, 3.2.
set -euo pipefail

frame="${1:?usage: sign-frame FRAME}"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
name="$("$root/bin/swoop" tool name)-dev"
id="$("$root/bin/swoop" tool id)"

if security find-identity -v -p codesigning 2>/dev/null | grep "\"$name\"" >/dev/null; then
  codesign -f -s "$name" -i "$id.shell" "$frame"
  echo "signed $frame as $name"
else
  echo "signed $frame ad-hoc; scripts/codesign-identity makes $name"
fi
