#!/usr/bin/env bash
# tap-formula: print the Homebrew formula for one release, for the tap at
# github.com/beatzball/homebrew-tap. The release workflow runs it after the
# tarballs are up and commits the result there; run it by hand to see what
# it would write.
#
#   scripts/tap-formula VERSION < SHA256SUMS
#
# The formula installs the released tarball whole under libexec: bin/swoop
# finds its tools beside itself and the extensions at ../extensions, and
# the frame needs its resource bundle beside it. Only the commands are
# linked into bin. A service runs the frame on macOS.
#
# The formula's name, its class, the tarballs, the log and every word in
# the caveats that names the tool come from the file `tool`, which the
# launcher reads. Only the repository's address is spelled here.
#
# Written for the bash macOS ships, 3.2.
set -euo pipefail

v="${1:-}"
[ -n "$v" ] || { echo "usage: tap-formula VERSION < SHA256SUMS" >&2; exit 2; }
sums="$(cat)"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
repo="beatzball/swoop"
name="$("$root/bin/swoop" tool name)"
hotkey="$("$root/bin/swoop" tool hotkey)"
# A formula's class is its name with a capital: Homebrew finds one by the other.
class="$(printf '%s' "$name" | awk '{ print toupper(substr($0, 1, 1)) substr($0, 2) }')"

# sum NAME prints the checksum listed for that tarball, or fails: a release
# missing a target must not become a formula that cannot install.
sum() {
  local s
  s="$(printf '%s\n' "$sums" | awk -v n="$name-$v-$1.tar.gz" '$2 == n || $2 == "*" n { print $1 }')"
  [ -n "$s" ] || { echo "tap-formula: no checksum for $name-$v-$1.tar.gz" >&2; exit 1; }
  printf '%s' "$s"
}

base="https://github.com/$repo/releases/download/v$v"

cat <<EOF
# $name $v. Generated by scripts/tap-formula in $repo on every
# release: change it there, not here.
class $class < Formula
  desc "Keyboard launcher: fzf finds, libghostty draws, extensions print lines"
  homepage "https://github.com/$repo"
  license "MIT"

  depends_on "fzf"

  on_macos do
    on_arm do
      url "$base/$name-$v-darwin-arm64.tar.gz"
      sha256 "$(sum darwin-arm64)"
    end
    on_intel do
      url "$base/$name-$v-darwin-amd64.tar.gz"
      sha256 "$(sum darwin-amd64)"
    end
  end

  on_linux do
    on_arm do
      url "$base/$name-$v-linux-arm64.tar.gz"
      sha256 "$(sum linux-arm64)"
    end
    on_intel do
      url "$base/$name-$v-linux-amd64.tar.gz"
      sha256 "$(sum linux-amd64)"
    end
  end

  def install
    # The tarball stays whole under libexec: bin/swoop finds its tools
    # beside itself and the extensions at ../extensions, and the frame
    # needs its resource bundle beside it. Only the commands are linked.
    libexec.install Dir["*"]
    Dir[libexec/"bin/swoop*"].each do |f|
      next if File.basename(f) == "swoop-shell-mac"

      bin.install_symlink f
    end
  end

  # The frame: a panel on $hotkey, at login, on a Mac. The
  # clipboard watcher starts itself the first time the launcher runs.
  service do
    run macos: [opt_libexec/"bin/swoop-shell-mac"]
    keep_alive true
    process_type :interactive
    environment_variables PATH: std_service_path_env, SWOOP_LAUNCHER: opt_libexec/"bin/swoop"
    log_path var/"log/$name.log"
    error_log_path var/"log/$name.log"
  end

  # Numbered, because the person reading this has just typed brew install
  # and wants to know what to do next: start it, press the key, and the
  # one permission macOS asks for later. Getting Started on the site says
  # the same three things at more length.
  def caveats
    if OS.mac?
      <<~EOS
        1. Start the frame, now and at every login:
             brew services start $name
        2. Press $hotkey. Esc hides it.
        3. The first time you paste a snippet or an emoji, or move a
           window, macOS asks for Accessibility for swoop-shell-mac.
           Turn it on and try again. Nothing else needs a permission.

        Releases are not signed yet, so after each brew upgrade remove
        swoop-shell-mac from System Settings > Privacy & Security >
        Accessibility and add it again.

        The service sees Homebrew's PATH only. If your AI command lives
        elsewhere, name it in full in ~/.config/$name/ai, for example:
          ~/.local/bin/claude -p

        $name restart, $name stop, $name start and $name status look after
        the frame. More: https://swoop.sh/docs/getting-started
      EOS
    else
      <<~EOS
        Run $name in a terminal. There is no frame on Linux yet.
        More: https://swoop.sh/docs/getting-started
      EOS
    end
  end

  test do
    assert_match "hi", pipe_output("#{bin}/swoop-md -w 40", "# hi\n")
    assert_equal "$v", (libexec/"VERSION").read.strip
  end
end
EOF
