#!/usr/bin/env python3
"""launcher-test: bin/swoop driven through a pseudo-terminal, end to end.

The unit tests cover the rules; this covers the wiring: the fzf flags and
bindings in bin/swoop, swoop-nav's answers to them, the extension calls,
swoop-ai's worker talking back to fzf through its socket. Every bug of one
evening lived in that wiring, and each was caught by a harness like this
one and then thrown away. This one stays.

A temp HOME, a fake extension and a fake AI command make it the same on
every machine; SWOOP_PICTURES=0 and SWOOP_NO_CLIPD=1 keep pictures and the
clipboard watcher out of it. Standard library only. Needs fzf and bin/
built (make build). Run it with `make e2e`.

Terminal output is read as a stream: escape sequences stripped, text
searched. That is enough to say "this word appeared after that key",
which is what every check here is.
"""

import datetime
import glob
import json
import os
import pty
import re
import select
import shutil
import signal
import stat
import socket
import subprocess
import sys
import tempfile
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ESC = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|\x1b[()][A-Z0-9]|\x1b[=>]|\x1b\][^\x07]*\x07|\x1b\\|\x1bP[^\x1b]*\x1b\\")


def fail(msg, tail=""):
    print("launcher-test: FAIL:", msg, file=sys.stderr)
    if tail:
        print("--- last screen output:", file=sys.stderr)
        print(tail[-2500:], file=sys.stderr)
    sys.exit(1)


def write_exe(path, body):
    with open(path, "w") as f:
        f.write(body)
    os.chmod(path, os.stat(path).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)


def cur(s):
    """The row under the cursor. Mid-reload fzf can hold no rows, and then
    no current one."""
    return (s.get("current") or {}).get("text", "")


def has(s, text):
    """Whether any match in the state holds `text`."""
    return any(text in m["text"] for m in s.get("matches", []))


def down_to(ln, text, what, most=10):
    """Move the cursor down until the current row holds `text`, `most`
    rows at the most. Each Down waits for the cursor to leave the row it
    was on, so the next one is not sent before this one has moved it."""
    for _ in range(most):
        st = ln.wait_state(lambda s: s.get("current"), what="a row under the cursor")
        if text in cur(st):
            return
        idx = st["current"]["index"]
        ln.press("\x1b[B", lambda s: s.get("current") and s["current"]["index"] != idx, what=f"the cursor moving down, on the way to {what}")
    fail(f"no {what}: {ln.state()}", ln.buf)


class Launcher:
    """One swoop in a pseudo-terminal."""

    def __init__(self, env, cols=120, rows=30):
        self.pid, self.fd = pty.fork()
        if self.pid == 0:
            os.execvpe(os.path.join(ROOT, "bin", "swoop"), ["swoop"], env)
        import fcntl
        import struct
        import termios
        fcntl.ioctl(self.fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
        self.raw = ""
        self._buf = ""
        self._stripped_upto = 0
        self.eof = False

    def read(self, seconds):
        """Read for up to `seconds`, appending to the buffer."""
        end = time.time() + seconds
        while time.time() < end:
            r, _, _ = select.select([self.fd], [], [], 0.05)
            if not r:
                continue
            try:
                data = os.read(self.fd, 65536)
            except OSError:
                self.eof = True
                return
            if not data:
                self.eof = True
                return
            self.raw += data.decode("utf-8", "replace")

    @property
    def buf(self):
        """The output so far with escape sequences stripped. Stripping runs
        over the whole raw text each time, because a sequence can arrive
        split across two reads and a per-chunk strip would leave half of
        it behind."""
        if self._stripped_upto != len(self.raw):
            self._buf = ESC.sub("", self.raw)
            self._stripped_upto = len(self.raw)
        return self._buf

    def send(self, text):
        os.write(self.fd, text.encode() if isinstance(text, str) else text)

    def expect(self, pattern, timeout=10.0, what=None):
        """Wait until `pattern` (a regex) shows up in output received since
        the last mark. Returns the match. Only for what fzf's state does
        not hold: a prompt, a preview, a note printed on the way out.
        Anything in the state (the query, the counts, the rows) is waited
        on through wait_state, which is exact where the stream is not.
        Ten seconds, because the macOS runner is three times slower than a
        laptop."""
        end = time.time() + timeout
        while True:
            m = re.search(pattern, self.buf[self.mark:])
            if m:
                return m
            if time.time() > end or self.eof:
                fail(f"did not see {what or pattern!r} within {timeout}s", self.buf)
            self.read(0.1)

    sock = None
    key = None

    def state(self, limit=0):
        """fzf's own account of itself, through its socket: the query, the
        match count, the row under the cursor, and with a limit the first
        that many matches. Exact where the screen stream is not: a redraw
        in flight can show the old list under the new prompt, but fzf
        knows what it holds."""
        if self.sock is None:
            socks = glob.glob(os.path.join(os.environ["SWOOP_TEST_TMP"], "swoop-state.*.sock"))
            if not socks:
                return None
            self.sock = socks[0]
        try:
            c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            c.settimeout(2)
            c.connect(self.sock)
            path = f"/?limit={limit}" if limit else "/"
            c.sendall(f"GET {path} HTTP/1.0\r\nx-api-key: {self.key}\r\n\r\n".encode())
            data = b""
            while True:
                chunk = c.recv(65536)
                if not chunk:
                    break
                data += chunk
            c.close()
        except OSError:
            return None
        body = data.split(b"\r\n\r\n", 1)[-1]
        try:
            return json.loads(body)
        except ValueError:
            return None

    def wait_state(self, pred, timeout=10.0, what="", limit=1000):
        """Wait until fzf's state satisfies pred; returns it. The state
        carries up to `limit` matches, for a pred that looks past the
        current row."""
        end = time.time() + timeout
        while time.time() < end:
            st = self.state(limit)
            if st and pred(st):
                return st
            self.read(0.1)
        fail(f"fzf never reached: {what}; last state {self.state()}", self.buf)

    def press(self, keys, until=None, screen=None, what="", timeout=10.0):
        """Send keys, then wait for the exact change they cause: `until`, a
        pred on fzf's state, and or `screen`, a regex on the output after
        the keys. Never a pause. The next key waits on this one's effect,
        so it cannot land while this one's transform or reload is still in
        flight: an Esc's clear-query eating letters typed after it, or a
        letter read together with an Esc as alt-letter. `until` must be
        false before the keys, or the wait would pass at once and prove
        nothing; where the state does not change, wait on the screen
        instead. The mark moves before the keys, so a screen wait cannot
        be met by text already on the screen, such as a prompt from the
        last visit.

        No chain ends in fzf's wait, which drops keys (see nav.LandEvent),
        so a key sent before a pop or a tick has landed is read, not lost.
        A pop's cursor lands by an event after its list shows; a pred that
        names the row under the cursor waits for that too."""
        if until:
            before = self.state(1000)
            if before and until(before):
                fail(f"already true before {keys!r}, so no wait on it: {what}", self.buf)
        self.clear()
        self.send(keys)
        st = None
        if until:
            st = self.wait_state(until, timeout=timeout, what=what)
        if screen:
            self.expect(screen, timeout=timeout, what=what)
        return st

    def clear(self):
        """Mark: later expects see only what comes after this point."""
        self.mark = len(self.buf)

    mark = 0

    def wait_exit(self, timeout=5.0):
        end = time.time() + timeout
        while time.time() < end:
            pid, status = os.waitpid(self.pid, os.WNOHANG)
            if pid:
                return os.WEXITSTATUS(status) if os.WIFEXITED(status) else -1
            self.read(0.1)
        fail("swoop did not exit", self.buf)

    def kill(self):
        # Keep reading while waiting. A process leaving a terminal waits
        # for its output to drain, so a blocking waitpid with nobody
        # reading the pty hung the whole tree in exit, fzf and its
        # preview with it, for good. SIGKILL if it takes too long.
        try:
            os.kill(self.pid, signal.SIGTERM)
        except OSError:
            return
        end = time.time() + 5
        while True:
            try:
                pid, _ = os.waitpid(self.pid, os.WNOHANG)
            except OSError:
                break
            if pid:
                break
            if time.time() > end:
                try:
                    os.kill(self.pid, signal.SIGKILL)
                except OSError:
                    pass
                end = float("inf")
            self.read(0.1)
            if self.eof:
                time.sleep(0.05)
        try:
            os.close(self.fd)
        except OSError:
            pass


def main():
    if not shutil.which("fzf"):
        fail("fzf is not on PATH")
    for tool in ("swoop-nav", "swoop-ai", "swoop-list", "swoop-icons"):
        if not os.path.exists(os.path.join(ROOT, "bin", tool)):
            fail(f"bin/{tool} is not built; run make build")

    tmp = tempfile.mkdtemp(prefix="swoop-launcher-test.")
    home = os.path.join(tmp, "home")
    os.makedirs(os.path.join(home, ".config", "swoop"))
    ext_dir = os.path.join(tmp, "ext", "fake")
    os.makedirs(ext_dir)
    marker = os.path.join(tmp, "ran")
    slow = os.path.join(tmp, "slow")

    # The fake extension: one view row, one plain row, a view that filters
    # three words, an action menu, and a run that leaves a marker.
    write_exe(os.path.join(ext_dir, "fake"), f"""#!/usr/bin/env bash
row() {{ printf '%s\\t%s\\t%s\\t%s\\t%s\\n' "$1" "$2" "$3" "$4" "$5"; }}
case "$1" in
  list)
    # Slow on demand: a pop's reload still in flight when the next keys
    # arrive, which is when a waiting fzf dropped them.
    [ -e '{slow}' ] && sleep 1
    row things view '' 'Fake Things' 'a view of fake things'
    row plain command '' 'Fake Plain Row' 'runs and leaves a marker' ;;
  view)
    q="${{3:-}}"
    for w in apple banana cherry; do
      case "$w" in *"$q"*) row "$w" fruit '' "$w" 'fruit' ;; esac
    done ;;
  preview) echo "preview of $2" ;;
  actions) row copy action '' 'Copy Fake' 'Enter'; row delete refresh '' 'Delete Fake' '' ;;
  run) echo "$2 ${{3:-}}" > '{marker}' ;;
esac
""")
    # Its keyword, which scopes the root to its two rows.
    with open(os.path.join(ext_dir, "keyword"), "w") as f:
        f.write("fk\n")
    # A quicklink with an argument, and a fake `open` (and xdg-open, for
    # Linux) ahead of the real one on PATH that records what it was asked
    # to open instead of opening it.
    with open(os.path.join(home, ".config", "swoop", "quicklinks.tsv"), "w") as f:
        f.write("Fake Search\thttps://example.test/find?q={argument}\n")
    fakebin = os.path.join(tmp, "fakebin")
    os.makedirs(fakebin)
    opened = os.path.join(tmp, "opened")
    for name in ("open", "xdg-open"):
        write_exe(os.path.join(fakebin, name), f"""#!/usr/bin/env bash
printf '%s\\n' "$@" > '{opened}'
""")

    # A snippet with a keyword, a placeholder filled on Enter, and a
    # {cursor}, which outside a frame is only removed.
    snippets = os.path.join(home, ".config", "swoop", "snippets")
    os.makedirs(snippets)
    with open(os.path.join(snippets, "fake-greeting.md"), "w") as f:
        f.write("Fake Greeting\nkeyword: ;fg\n\nHello on {date}{cursor}!\n")

    # A note, with a word inside it that is not in its title.
    notes_dir = os.path.join(home, ".data", "swoop", "notes")
    os.makedirs(notes_dir)
    fake_note = os.path.join(notes_dir, "fake-meeting.md")
    with open(fake_note, "w") as f:
        f.write("# Fake Meeting\n\nremember the zucchini\n")

    # A fake editor, set through `editor =` in the config: it appends a
    # line to the file it is given, and exits, as :q would after an edit.
    # It runs with the terminal, under fzf's execute, so it also prints.
    write_exe(os.path.join(fakebin, "fake-editor"), """#!/usr/bin/env bash
echo "fake-editor on ${@: -1}"
printf 'edited by the fake editor\\n' >> "${@: -1}"
""")
    with open(os.path.join(home, ".config", "swoop", "config"), "w") as f:
        f.write("editor = fake-editor --flag\n")

    # A fake clipboard, pbcopy on a Mac and wl-copy on Linux, that
    # records what it was given.
    copied = os.path.join(tmp, "copied")
    for name in ("pbcopy", "wl-copy"):
        write_exe(os.path.join(fakebin, name), f"""#!/usr/bin/env bash
cat > '{copied}'
""")

    # A fake osascript for Reminders on a Mac: the list after a pause, from
    # made-up reminders. Any other script goes to the real one.
    write_exe(os.path.join(fakebin, "osascript"), """#!/usr/bin/env bash
case "$*" in
  *EKEventStore*)
    sleep 2
    printf 'x-apple-reminder://A\\t\\t\\tHome\\tFake water the plants\\n' ;;
  *Reminders*) exit 1 ;;
  *) exec /usr/bin/osascript "$@" ;;
esac
""")

    # The fake AI command: a status line on stderr, a pause, an answer.
    with open(os.path.join(home, ".config", "swoop", "ai"), "w") as f:
        f.write("sh -c 'echo \"using Fake\" >&2; sleep 1.2; echo \"The answer is 42\"'\n")

    key = "launcher-test-key"
    os.environ["SWOOP_TEST_TMP"] = tmp
    env = dict(os.environ)
    env.update({
        "FZF_API_KEY": key,
        "HOME": home,
        "XDG_CONFIG_HOME": os.path.join(home, ".config"),
        "XDG_STATE_HOME": os.path.join(home, ".state"),
        "XDG_DATA_HOME": os.path.join(home, ".data"),
        "TMPDIR": tmp,
        "TERM": "xterm-256color",
        "SWOOP_PICTURES": "0",
        "SWOOP_NO_CLIPD": "1",
        "SWOOP_EXTENSIONS": os.path.join(tmp, "ext"),
        "PATH": fakebin + os.pathsep + os.path.join(ROOT, "bin") + os.pathsep + env.get("PATH", ""),
    })
    # Not inside a frame, even when this runs from one: Enter must copy,
    # not send a keystroke to whatever is on the screen.
    env.pop("SWOOP_SHELL", None)
    env.pop("SWOOP_SHELL_PID", None)
    env.pop("SWOOP_PASTE", None)
    config = os.path.join(home, ".config", "swoop", "config")

    def check(name, fn):
        print(f"  {name} ...", end="", flush=True)
        fn()
        print(" ok")

    L = Launcher(env)
    L.key = key
    try:
        # 1. the root list, and typing filters it
        def root():
            # On a Mac the root list holds every app, sorted by title, so
            # the fake rows are off screen until typing narrows it.
            L.wait_state(lambda s: s["totalCount"] > 3, what="the launcher's list")
            L.press("fake", lambda s: s["query"] == "fake" and has(s, "Fake Things") and has(s, "Fake Plain Row"), what="the fake view row and plain row after typing 'fake'")
            L.press(" plain", lambda s: s["query"] == "fake plain" and s["matchCount"] == 1 and "Fake Plain Row" in cur(s), what="one match for 'fake plain', the plain row")
        check("root list and filter", root)

        # 2. a view: push, ask, Esc clears, Esc pops with the text back
        def view():
            L.press("\x1b", lambda s: s["query"] == "" and has(s, "Fake Search"), what="the bar cleared at the root")
            L.press("fake th", lambda s: s["query"] == "fake th" and "Fake Things" in cur(s), what="the view row for 'fake th'")
            L.press("\r", lambda s: s["query"] == "" and s["matchCount"] == 3 and has(s, "banana"),
                    screen=r"Fake Things > ", what="the view's prompt and rows")
            st = L.press("err", lambda s: s["query"] == "err" and s["matchCount"] == 1, what="the extension leaving one row for 'err'")
            if "cherry" not in cur(st):
                fail(f"the one row should be cherry: {st['current']}", L.buf)
            # clears 'err'
            L.press("\x1b", lambda s: s["query"] == "" and s["matchCount"] == 3, what="all three rows back after Esc cleared the bar")
            # pops: the text back at once, while the root's rows are still
            # on their way (the fake list is slow here), and letters typed
            # then are kept, not dropped as fzf's wait dropped them; the
            # rows for all of it arrive, so the ctrl-k below lands on the
            # view row and not on a fruit
            open(slow, "w").close()
            try:
                L.press("\x1b", lambda s: s["query"] == "fake th", what="the earlier text back after popping")
                L.press("ings", lambda s: s["query"] == "fake things" and "Fake Things" in cur(s), what="every letter typed right after the pop, and the root list")
            finally:
                os.remove(slow)
        check("view push, filter, Esc, Esc, typing at once", view)

        # 3. the action menu
        def actions():
            # ctrl-k on the highlighted view row
            L.press("\x0b", lambda s: has(s, "Copy Fake") and has(s, "Delete Fake"), screen=r"actions > ", what="the actions menu")
            L.press("\x1b", lambda s: s["query"] == "fake things" and "Fake Things" in cur(s), what="back at the root with the text")
        check("action menu", actions)

        # 4. Ask AI: Tab, Enter, thinking, status, answer, Esc Esc
        def ask():
            L.press("\x1b", lambda s: s["query"] == "" and has(s, "Fake Search"), what="the bar cleared at the root")
            L.press("\t", lambda s: "ext/ai/new" in cur(s), screen=r"Ask AI > ", what="the Ask AI pane, New conversation")
            L.press("what is the answer", lambda s: s["query"] == "what is the answer", what="the question in the bar")
            L.press("\r", screen=r"thinking", what="the conversation row saying thinking")
            L.expect(r"using Fake", what="the command's stderr under the dots")
            L.expect(r"The answer is 42", timeout=15, what="the answer in the preview")
            L.wait_state(lambda s: "1 turn" in cur(s), what="the subtitle after the answer, the conversation under the cursor")
            # ctrl-k on New conversation: the model list; Enter on one sets it
            L.press("\x1b[A", lambda s: "ext/ai/new" in cur(s), what="the cursor on New conversation")  # up
            L.press("\x0b", lambda s: has(s, "The line in"), screen=r"New conversation actions > ", what="the model menu, the custom-line choice in it")
            L.press("claude", lambda s: s["query"] == "claude" and s["matchCount"] == 1, what="the claude row")
            # The pane is back only once New is under the cursor again: a
            # ctrl-k sent before that lands on a model row and is ignored.
            L.press("\r", lambda s: "ext/ai/new" in cur(s), screen=r"Ask AI > ", what="the pane back with New under the cursor")
            with open(config) as f:
                if "ai = claude" not in f.read():
                    fail("ctrl-k on New did not set ai = claude", L.buf)
            # and back to the custom line, so the fake model answers again
            L.press("\x0b", lambda s: has(s, "The line in"), screen=r"New conversation actions > ", what="the model menu again")
            L.press("The line", lambda s: s["query"] == "The line" and s["matchCount"] == 1, what="the custom-line row")
            L.press("\r", lambda s: "ext/ai/new" in cur(s), screen=r"Ask AI > ", what="the pane back again with New under the cursor")
            # Back at the root: the whole list, an empty bar (it was empty
            # before Tab).
            L.press("\x1b", lambda s: s["query"] == "" and has(s, "Fake Search"), what="the root list after Esc from Ask AI")
        check("Ask AI", ask)

        # 4b. keywords: "def ap" opens Define with "ap" typed, and shows
        # only its rows; "fk plain" scopes the root to the fake extension,
        # which lists two rows and no view of its own to open.
        def keywords():
            # Every row a word from Define's view, none of them the root's
            # Define Word row: that one is the list from before the pane
            # opened, still on screen while its reload is in flight.
            def define_words(s):
                rows = s["matches"]
                if not os.path.exists("/usr/share/dict/words"):
                    return s["matchCount"] == 0
                return s["matchCount"] > 0 and all(
                    m["text"].startswith("ext/define/") and m["text"].split("\t")[1] == "word"
                    and m["text"].split("\t")[3].lower().startswith("ap") for m in rows)
            L.press("def ap", lambda s: s["query"] == "ap" and define_words(s), screen=r"Define Word > ",
                    what="the Define pane with 'ap' typed, and only its words")
            L.press("\x1b", lambda s: s["query"] == "" and not has(s, "\tap"), what="the bar cleared in Define")
            # Esc comes back to the whole root, with an empty bar, not the
            # keyword, which would only open Define again.
            L.press("\x1b", lambda s: s["query"] == "" and has(s, "Fake Search"), what="the whole root list after Define")
            L.press("fk plain", lambda s: s["query"] == "fk plain" and s["matchCount"] == 1 and "Fake Plain Row" in cur(s),
                    what="only the fake extension's plain row for 'fk plain'")
            L.press("\x1b", lambda s: s["query"] == "" and has(s, "Fake Search"), what="the whole root list back after Esc")
        check("keywords", keywords)

        # 5. the divider keys write the width
        def divider():
            # The key's transform writes the file; on a slow runner that
            # can take longer than a fixed pause, so the file is polled.
            def saved(line, timeout=10.0):
                end = time.time() + timeout
                while time.time() < end:
                    with open(config) as f:
                        if line in f.read():
                            return True
                    L.read(0.1)
                return False
            L.send("\x1b[1;3D")  # alt-left
            if not saved("preview = 63"):
                fail("alt-left did not save preview = 63", L.buf)
            L.send("\x1b[1;3C")  # alt-right
            if not saved("preview = 58"):
                fail("alt-right did not save preview = 58", L.buf)
        check("divider keys", divider)

        # 6. Settings: the key opens the pane, a choice sets a value and returns
        def settings_pane():
            # Text in the bar first: Settings keeps it and gives it back on
            # the way out, which is how the return to the root is known.
            L.press("fake", lambda s: s["query"] == "fake" and has(s, "Fake Search"), what="text in the bar before Settings")
            L.press("\x1b,", lambda s: s["query"] == "" and has(s, "Preview width"), screen=r"Settings > ", what="the Settings pane and its rows")  # alt-,
            L.press("preview", lambda s: s["query"] == "preview" and s["matchCount"] == 1 and "Preview width" in cur(s), what="one row for 'preview'")
            L.press("\r", lambda s: s["query"] == "" and has(s, "70%"), screen=r"Preview width > ", what="the choices pane")
            L.press("70", lambda s: s["query"] == "70" and s["matchCount"] == 1, what="the 70% choice")
            L.press("\r", lambda s: s["query"] == "preview" and "Preview width" in cur(s) and "70%" in cur(s), what="back in Settings with the earlier text, the new width in the row's subtitle")
            with open(config) as f:
                if "preview = 70" not in f.read():
                    fail("the choice did not write preview = 70", L.buf)
            L.press("\x1b", lambda s: s["query"] == "" and has(s, "Preview width"), what="the bar cleared in Settings")  # clears 'preview'
            L.press("\x1b", lambda s: s["query"] == "fake" and has(s, "Fake Search"), what="the root with the earlier text back")  # pops to the root
            # and clear it for the next step
            L.press("\x1b", lambda s: s["query"] == "" and has(s, "Fake Search"), what="an empty bar at the root")
        check("Settings pane", settings_pane)

        # 6b. Settings, Extensions: Enter turns the fake extension off, and
        # its rows leave the root; Enter again brings them back.
        def extensions_toggle():
            def root_has_fake_rows():
                # "Fake Search", the quicklink, answers "fake" whether the
                # fake extension is on or off: once it is in, the reload
                # for the text has landed, and the list can be read.
                end = time.time() + 10
                while time.time() < end:
                    st = L.state(limit=1000)
                    texts = [m["text"] for m in (st or {}).get("matches", [])]
                    if st and st["query"] == "fake" and any("Fake Search" in t for t in texts):
                        return any("Fake Things" in t for t in texts)
                    L.read(0.1)
                fail(f"the root list for 'fake' never came; last state {L.state()}", L.buf)

            def flip(want_off):
                L.press("\x1b,", lambda s: s["query"] == "" and has(s, "Extensions"), screen=r"Settings > ", what="the Settings pane")  # alt-,
                L.press("ext", lambda s: s["query"] == "ext" and s["matchCount"] == 1 and "Extensions" in cur(s), what="the Extensions row")
                L.press("\r", lambda s: s["query"] == "" and has(s, "extension/fake"), screen=r"Extensions > ", what="the Extensions pane")
                L.press("fake", lambda s: s["query"] == "fake" and s["matchCount"] == 1 and "extension/fake" in cur(s), what="the fake extension's row")
                # A toggle stays: the same pane, the bar cleared, the mark
                # flipped on the row.
                mark = "off" if want_off else "on"

                def flipped(s):
                    rows = [m["text"] for m in s["matches"] if "extension/fake" in m["text"]]
                    return s["query"] == "" and rows and (("\toff" in rows[0]) == want_off)
                L.press("\r", flipped, what=f"the fake row showing {mark}")
                with open(config) as f:
                    text = f.read()
                if want_off != ("off = fake" in text):
                    fail(f"the config after turning fake {mark}:\n{text}", L.buf)
                L.press("\x1b", lambda s: s["query"] == "ext" and "Extensions" in cur(s), what="back in Settings")  # pops to Settings, 'ext' back in the bar
                L.press("\x1b", lambda s: s["query"] == "" and has(s, "Extensions"), what="the bar cleared in Settings")  # clears 'ext'
                # pops to the root. The wait is on the root's own rows, not
                # an empty bar, which Settings had too: typed before the
                # pop lands, "fake" is read as alt-f, or eaten by the
                # pop's clear-query.
                L.press("\x1b", lambda s: s["query"] == "" and has(s, "Fake Search"), what="the root list after Settings")

            def type_fake():
                L.press("fake", lambda s: s["query"] == "fake", what="'fake' in the bar at the root")

            type_fake()
            if not root_has_fake_rows():
                fail("the fake rows should be at the root before turning it off", L.buf)
            L.press("\x1b", lambda s: s["query"] == "" and has(s, "Fake Search"), what="an empty bar at the root")  # clear the bar
            flip(want_off=True)
            type_fake()
            if root_has_fake_rows():
                fail("the fake rows are still at the root with fake turned off", L.buf)
            L.press("\x1b", lambda s: s["query"] == "" and has(s, "Fake Search"), what="an empty bar at the root")
            flip(want_off=False)
            type_fake()
            if not root_has_fake_rows():
                fail("the fake rows did not come back with fake turned on", L.buf)
            L.press("\x1b", lambda s: s["query"] == "" and has(s, "Fake Search"), what="an empty bar at the root")
        check("Settings, Extensions: off and on", extensions_toggle)

        # 7. Enter on a plain row runs it and the launcher exits
        def run():
            L.press("plain", lambda s: s["query"] == "plain" and "Fake Plain Row" in cur(s), what="the plain row")
            L.send("\r")
            code = L.wait_exit()
            if not os.path.exists(marker):
                fail(f"the fake extension's run did not happen (exit {code})", L.buf)
            with open(marker) as f:
                if f.read().strip() != "plain":
                    fail("run got the wrong id", L.buf)
        check("Enter runs and exits", run)

        # 8. the open was counted: a new launcher leads with that row, marked
        def recent():
            usage_log = os.path.join(home, ".state", "swoop", "usage.jsonl")
            if not os.path.exists(usage_log):
                fail("the run was not recorded in the usage log", "")
            with open(usage_log) as f:
                if "ext/fake/plain" not in f.read():
                    fail("the usage log does not name the row that ran", "")
            again = Launcher(env)
            again.key = key
            try:
                # The count can arrive a moment before the cursor row does.
                st = again.wait_state(lambda s: s["totalCount"] > 3 and s.get("current"), what="the second launcher's list")
                first = st["current"]["text"]
                if "Fake Plain Row" not in first or "recent" not in first:
                    fail(f"the first row should be the recent one, marked: {first!r}", again.buf)
                # Stats lists it too
                again.press("stats", lambda s: s["query"] == "stats" and s["matchCount"] >= 1, what="the Stats row")
                again.press("\r", lambda s: s["query"] == "" and any("Fake Plain Row" in m["text"] and "once" in m["text"] for m in s["matches"]),
                            screen=r"Stats > ", what="the Stats pane, the opened row in it with its count")
            finally:
                again.kill()
        check("Used recently and Stats", recent)

        # 9. a quicklink with an argument: Enter opens its pane, the text
        # typed becomes the row, Enter opens the link with the text in it
        def quicklink():
            third = Launcher(env)
            third.key = key
            try:
                third.wait_state(lambda s: s["totalCount"] > 3, what="the third launcher's list")
                st = third.press("fake search", lambda s: s["query"] == "fake search" and s["matchCount"] == 1, what="the quicklink row")
                if "Fake Search" not in cur(st):
                    fail(f"the match should be the quicklink: {st['current']}", third.buf)
                third.press("\r", lambda s: s["query"] == "" and "Type, then Enter" in cur(s), screen=r"Fake Search > ", what="the quicklink's pane and its hint row")
                third.press("hello world", lambda s: s["query"] == "hello world" and "hello+world" in cur(s), what="the row carrying the text, link filled in")
                third.send("\r")
                code = third.wait_exit()
                if not os.path.exists(opened):
                    fail(f"the link was not opened (exit {code})", third.buf)
                with open(opened) as f:
                    got = f.read().split()
                if got != ["https://example.test/find?q=hello+world"]:
                    fail(f"open got the wrong arguments: {got}", third.buf)
            finally:
                third.kill()
        check("quicklink with an argument", quicklink)

        # 10. emoji: the view, a search, Enter copies (outside a frame
        # there is no app to paste into); the next time it leads the view,
        # and ctrl-k on a thumbs up offers the six tones
        def emoji():
            fourth = Launcher(env)
            fourth.key = key
            try:
                fourth.wait_state(lambda s: s["totalCount"] > 3, what="the fourth launcher's list")
                fourth.press("emoji", lambda s: s["query"] == "emoji" and "Emoji & Symbols" in cur(s), what="the Emoji & Symbols row")
                fourth.press("\r", lambda s: s["query"] == "" and s["totalCount"] > 1000, screen=r"Emoji & Symbols > ", what="the emoji view")
                fourth.press("rocket", lambda s: s["query"] == "rocket" and "\U0001F680" in cur(s), what="the rocket first")
                fourth.send("\r")
                code = fourth.wait_exit()
                if not os.path.exists(copied):
                    fail(f"Enter on the rocket copied nothing (exit {code})", fourth.buf)
                with open(copied, encoding="utf-8") as f:
                    got = f.read()
                if got != "\U0001F680":
                    fail(f"the clipboard got {got!r}", fourth.buf)
                fourth.expect(r"Copied", what="the note that it was copied")
            finally:
                fourth.kill()
            fifth = Launcher(env)
            fifth.key = key
            try:
                fifth.wait_state(lambda s: s["totalCount"] > 3, what="the fifth launcher's list")
                fifth.press("emoji", lambda s: s["query"] == "emoji" and "Emoji & Symbols" in cur(s), what="the Emoji & Symbols row")
                st = fifth.press("\r", lambda s: s["query"] == "" and s["totalCount"] > 1000, what="the whole table in the view")
                first = cur(st)
                if "\U0001F680" not in first or "recent" not in first:
                    fail(f"the rocket should lead the view, marked: {first!r}", fifth.buf)
                fifth.press("thumbs up", lambda s: s["query"] == "thumbs up" and "\U0001F44D" in cur(s), what="the thumbs up")
                fifth.press("\x0b", lambda s: s["totalCount"] == 8 and has(s, "medium-dark"), screen=r"thumbs up actions > ", what="its actions: Paste, Copy and six tones")
            finally:
                fifth.kill()
        check("emoji", emoji)

        # 11. a snippet: its name finds its row, Enter copies the text
        # with {date} filled (outside a frame there is no app to paste
        # into, as with emoji)
        def snippet():
            if os.path.exists(copied):
                os.remove(copied)
            sixth = Launcher(env)
            sixth.key = key
            try:
                sixth.wait_state(lambda s: s["totalCount"] > 3, what="the sixth launcher's list")
                # The Snippets row opens a pane: New snippet, then the snippets.
                sixth.press("snippets", lambda s: s["query"] == "snippets" and "ext/snippets/+snippets" in cur(s), what="the Snippets row")
                sixth.press("\r", lambda s: s["query"] == "" and s["totalCount"] == 2 and "+new" in cur(s), screen=r"Snippets > ", what="the Snippets pane, New snippet first")
                sixth.press("greet", lambda s: s["query"] == "greet" and s["totalCount"] == 2 and "+new" in cur(s), what="the pane filtered, New snippet still first")
                sixth.press("\x1b", lambda s: s["query"] == "" and s["totalCount"] == 2, what="the bar cleared in the pane")
                sixth.press("\x1b", lambda s: s["query"] == "snippets" and s["totalCount"] > 3, what="back at the root with the text")
                sixth.press("\x1b", lambda s: s["query"] == "", what="the bar cleared at the root")
                st = sixth.press("fake greeting", lambda s: s["query"] == "fake greeting" and "Fake Greeting" in cur(s), what="the snippet row")
                if ";fg" not in st["current"]["text"]:
                    fail(f"the snippet's keyword should be in its row: {st['current']}", sixth.buf)
                before = datetime.date.today().isoformat()
                sixth.send("\r")
                code = sixth.wait_exit()
                after = datetime.date.today().isoformat()
                if not os.path.exists(copied):
                    fail(f"Enter on the snippet copied nothing (exit {code})", sixth.buf)
                with open(copied, encoding="utf-8") as f:
                    got = f.read()
                if got not in (f"Hello on {before}!", f"Hello on {after}!"):
                    fail(f"the clipboard got {got!r}", sixth.buf)
                sixth.expect(r"Copied Hello on", what="the note that it was copied")
            finally:
                sixth.kill()
        check("snippet", snippet)
        # 12. notes: the root row opens the view, the note is in it, a
        # word from inside it still finds it, Enter hands the terminal to
        # the editor (kind "terminal") and the launcher is still there
        # after, same query, the preview showing the edit; New note makes
        # a file from what was typed and edits that; ctrl-k Open in app
        # still hands the file to `open` and ends the launcher
        def notes():
            def open_view(ln):
                ln.wait_state(lambda s: s["totalCount"] > 3, what="the launcher's list")
                ln.press("notes", lambda s: s["query"] == "notes" and s["matchCount"] >= 1, what="rows for 'notes'")
                # On a Mac the Notes app matches too: move to the row
                # that is the extension's.
                down_to(ln, "markdown notes", "the Notes row")
                ln.press("\r", lambda s: s["query"] == "" and s["matchCount"] == 2, screen=r"Notes > ", what="the notes view: New note and the note")

            if os.path.exists(opened):
                os.remove(opened)
            eighth = Launcher(env)
            eighth.key = key
            try:
                open_view(eighth)
                eighth.wait_state(lambda s: has(s, "Fake Meeting"), what="the note's title")
                # The count is 2 before and after the reload, so the wait
                # is on the row text, which only the reload changes.
                eighth.press("zucchini", lambda s: s["query"] == "zucchini" and s["matchCount"] == 2 and "New note: zucchini" in cur(s), what="New note leading the view, and the note found by a word inside it")
                st = eighth.press("\x1b[B", lambda s: "Fake Meeting" in cur(s), what="the cursor on the note")
                if "remember the zucchini" not in cur(st):
                    fail(f"the matching line should be the subtitle: {st['current']}", eighth.buf)
                eighth.press("\r", screen=r"fake-editor on .*fake-meeting\.md", what="the editor, run on the note")
                eighth.expect(r"edited by the fake editor", what="the preview redrawn with the edit")
                st = eighth.wait_state(lambda s: s["query"] == "zucchini" and "Fake Meeting" in s["current"]["text"], what="the launcher still open, same query, same row")
                eighth.expect(r"Notes > ", what="still in the notes view")
                if eighth.eof:
                    fail("the launcher ended after the editor", eighth.buf)
                with open(fake_note) as f:
                    body = f.read()
                if body != "# Fake Meeting\n\nremember the zucchini\nedited by the fake editor\n":
                    fail(f"the note holds {body!r}", eighth.buf)
                if os.path.exists(opened):
                    fail("Enter handed the note to open, not the editor", eighth.buf)
                # ctrl-k, Open in app: the old way, for a window, still
                # there, and it ends the launcher like any action.
                eighth.press("\x0b", lambda s: "Open in app" in cur(s), what="Open in app in the menu")
                eighth.send("\r")
                code = eighth.wait_exit()
                if not os.path.exists(opened):
                    fail(f"the note was not opened in the app (exit {code})", eighth.buf)
                with open(opened) as f:
                    got = f.read().splitlines()
                if [os.path.realpath(g) for g in got] != [os.path.realpath(fake_note)]:
                    fail(f"open got the wrong arguments: {got}", eighth.buf)
            finally:
                eighth.kill()

            ninth = Launcher(env)
            ninth.key = key
            try:
                open_view(ninth)
                ninth.press("Fake Idea", lambda s: s["query"] == "Fake Idea" and "New note: Fake Idea" in cur(s), what="the New note row")
                made = os.path.join(notes_dir, "fake-idea.md")
                # Back with the bar empty and the new note under the
                # cursor, not "New note: Fake Idea" again, where a second
                # Enter would make fake-idea-2.md.
                ninth.press("\r", lambda s: s["query"] == "" and s["matchCount"] == 3 and "Fake Idea" in cur(s) and "New note" not in cur(s),
                            screen=r"fake-editor on .*fake-idea\.md", what="the editor on the new note, then an empty bar and the note under the cursor")
                with open(made) as f:
                    body = f.read()
                if body != "# Fake Idea\n\nedited by the fake editor\n":
                    fail(f"the new note holds {body!r}", ninth.buf)
            finally:
                ninth.kill()
        check("notes", notes)

        # 13. the window rows are at the root, with a preview. No Enter:
        # that would move a real window, or, without Accessibility, open
        # System Settings, and neither belongs in a headless run.
        def window():
            seventh = Launcher(env)
            seventh.key = key
            try:
                seventh.wait_state(lambda s: s["totalCount"] > 3, what="the seventh launcher's list")
                st = seventh.press("left half", lambda s: s["query"] == "left half" and s["matchCount"] >= 1, what="the Left Half row")
                if "Left Half" not in cur(st):
                    fail(f"the first match should be Left Half: {st['current']}", seventh.buf)
                seventh.expect(r"Move the window to the left half", what="the Left Half preview")
            finally:
                seventh.kill()
        check("window rows at the root", window)

        # 13. tasks: the view, a task added with a date word, and Enter
        # on it ticks it while the view stays, reloaded (kind "toggle");
        # the headers by when, which the cursor never rests on, the
        # filter, and Done and back. The clock
        # is pinned to Monday 14 September 2026, since which header a
        # task is under depends on the day.
        def tasks():
            tasks_md = os.path.join(home, ".data", "swoop", "tasks.md")
            eighth = Launcher(dict(env, SWOOP_TASKS_NOW="2026-09-14T10:30"))
            eighth.key = key

            def titles(s):
                """The rows' titles, in order: the fourth field of a line,
                or for a header the third, where the launcher puts its
                title so that it starts at the left edge."""
                return [m["text"].split("\t")[3] or m["text"].split("\t")[2] for m in s.get("matches", [])]

            def file():
                with open(tasks_md) as f:
                    return f.read()
            try:
                eighth.wait_state(lambda s: s["totalCount"] > 3, what="the eighth launcher's list")
                eighth.press("tasks", lambda s: s["query"] == "tasks" and "ext/tasks/tasks" in cur(s), what="the Tasks row")
                eighth.press("\r", lambda s: "Type a task" in cur(s), screen=r"Tasks > ", what="the tasks view, the hint row of an empty list")
                eighth.press("buy milk tomorrow", lambda s: s["query"] == "buy milk tomorrow" and "Add task: buy milk" in cur(s), what="the Add task row")
                # The cursor keeps its row number, the first, which is now
                # the header over the new task, and is stepped off it.
                eighth.press("\r", lambda s: s["query"] == "" and titles(s) == ["Tomorrow", "buy milk"] and has(s, "tomorrow, Tue 15 Sep") and "buy milk" in cur(s),
                             what="the new task under a Tomorrow header, the cursor on the task, the view still open")
                if "- [ ] buy milk due: 2026-09-15\n" not in file():
                    fail(f"the file did not get the task: {file()!r}", eighth.buf)
                # Ticked, the task leaves this view for the done one.
                eighth.press("\r", lambda s: titles(s) == ["Type a task, then Enter", "Done"], what="the task ticked and gone from the open ones, the view still open")
                if "- [x] buy milk due: 2026-09-15\n" not in file():
                    fail(f"Enter did not tick the task in the file: {file()!r}", eighth.buf)
                # Two open tasks, then two Enters in one write: the second
                # is read after the first tick's reload lands, on the next
                # task, not dropped and not on the task just ticked.
                eighth.press("fake one", lambda s: s["query"] == "fake one" and "Add task: fake one" in cur(s), what="the Add task row for fake one")
                eighth.press("\r", lambda s: s["query"] == "" and titles(s) == ["Unscheduled", "fake one", "Done"], what="fake one added")
                eighth.press("fake two", lambda s: s["query"] == "fake two" and "Add task: fake two" in cur(s), what="the Add task row for fake two")
                eighth.press("\r", lambda s: s["query"] == "" and titles(s) == ["Unscheduled", "fake one", "fake two", "Done"] and "fake one" in cur(s),
                             what="fake two added, after fake one, the cursor on fake one")
                eighth.press("\r\r", lambda s: titles(s) == ["Type a task, then Enter", "Done"] and has(s, "3 tasks, Enter shows them"),
                             what="both tasks ticked after two quick Enters")
                if "- [x] fake one\n" not in file() or "- [x] fake two\n" not in file():
                    fail(f"two quick Enters did not tick both: {file()!r}", eighth.buf)

                # A task for each header, two for Today, out of order in
                # the file: due yesterday, today, tomorrow, Friday, the
                # 30th, and never.
                # Text typed and cleared reloads the view from the file.
                with open(tasks_md, "a") as f:
                    f.write("- [ ] fake none\n- [ ] fake the 30th due: 2026-09-30\n- [ ] fake friday due: 2026-09-18\n"
                            "- [ ] fake tomorrow due: 2026-09-15\n- [ ] fake today due: 2026-09-14\n- [ ] fake today two due: 2026-09-14\n- [ ] fake yesterday due: 2026-09-13\n")
                # Typing filters, and a group with no match has no header.
                eighth.press("friday", lambda s: s["query"] == "friday" and titles(s) == ["Add task: friday", "This week", "fake friday", "Done"] and "Add task" in cur(s),
                             what="the filter: one task under its header, the other headers gone, the cursor on Add")
                grouped = ["Past due", "fake yesterday", "Today", "fake today", "fake today two", "Tomorrow", "fake tomorrow", "This week", "fake friday",
                           "This month", "fake the 30th", "Unscheduled", "fake none", "Done"]
                eighth.press("\x1b", lambda s: s["query"] == "" and titles(s) == grouped and "fake yesterday" in cur(s),
                             what="the six headers in order, their tasks under each, Done last, the cursor on the first task and not on Past due")

                # The cursor steps over a header, both ways. Up from the
                # first task finds the header on the first row, and must
                # not stay there: the Down sent with it then goes from
                # the first task to Today's, not from Past due to the
                # first task.
                eighth.press("\x1b[B", lambda s: "fake today\t" in cur(s), what="Down from the last task of Past due: the first of Today")
                eighth.press("\x1b[A", lambda s: "fake yesterday" in cur(s), what="Up from the first task of Today: the last of Past due")
                eighth.press("\x1b[A\x1b[B", lambda s: "fake today\t" in cur(s), what="Up on the first task stays on it, so the Down after it lands on Today's first")
                # A click on a header does nothing, and the cursor goes
                # back where it was: the Down sent with it goes on from
                # there. Tomorrow is row 6, on the screen's line 8: the rows
                # start on line 3, under the bar.
                eighth.press("\x1b[<0;4;8M\x1b[<0;4;8m\x1b[B", lambda s: "fake today two" in cur(s), what="a click on Tomorrow leaves the cursor on fake today, so Down lands on fake today two")
                # A tick keeps the row number. The last task of Today
                # ticked, that number is Tomorrow's header: the cursor
                # goes on to the task under it.
                grouped.remove("fake today two")
                eighth.press("\r", lambda s: titles(s) == grouped and "fake tomorrow" in cur(s), what="the last task of Today ticked, the cursor on the first of Tomorrow, not on its header")
                if "- [x] fake today two due: 2026-09-14\n" not in file():
                    fail(f"Enter did not tick the task in the file: {file()!r}", eighth.buf)

                # Done is a switch: the done tasks only, under Back to
                # open, the most recently done first; and back again.
                down_to(eighth, "Enter shows them", "the Done row", most=20)
                eighth.press("\r", lambda s: titles(s) == ["Back to open", "fake today two", "fake two", "fake one", "buy milk"] and "Back to open" in cur(s),
                             screen=r"Done > ", what="the done tasks only, the last ticked first, under Back to open")
                eighth.press("milk", lambda s: s["query"] == "milk" and titles(s) == ["Back to open", "buy milk"], what="the filter in the done view")
                eighth.press("\x1b", lambda s: s["query"] == "" and len(titles(s)) == 5, what="the done view, unfiltered")
                eighth.press("\r", lambda s: titles(s) == grouped and "Enter shows them" in cur(s), screen=r"Tasks > ", what="Back to open: the open tasks again, the cursor on Done")
                # Esc does the same from the done view.
                eighth.press("\r", lambda s: "Back to open" in cur(s), screen=r"Done > ", what="the done tasks again")
                eighth.press("\x1b", lambda s: titles(s) == grouped and "Enter shows them" in cur(s), screen=r"Tasks > ", what="Esc from Done: the open tasks, the cursor on Done")
                # The view opened with tasks in it: the cursor is on the
                # first task, not on the header over it.
                eighth.press("\x1b", lambda s: s["query"] == "tasks" and "ext/tasks/tasks" in cur(s), what="the root again, on the Tasks row")
                eighth.press("\r", lambda s: titles(s) == grouped and "fake yesterday" in cur(s), screen=r"Tasks > ", what="Tasks opened with the cursor on the first task, not on Past due")
            finally:
                eighth.kill()
        check("tasks: groups, the filter, Done and back, two quick Enters", tasks)

        # 14. Reminders, on a Mac: the view answers at once with Loading,
        # and the rows follow without a keystroke, when the fetch behind
        # it asks fzf to reload. The fake osascript takes two seconds.
        def reminders():
            ninth = Launcher(env)
            ninth.key = key
            try:
                ninth.wait_state(lambda s: s["totalCount"] > 3, what="the launcher's list")
                ninth.press("reminders", lambda s: s["query"] == "reminders" and s["matchCount"] >= 1, what="rows for 'reminders'")
                # The Reminders app matches too: move to the extension's row.
                down_to(ninth, "Apple Reminders: past due", "the Reminders row")
                # Loading is there only until the fetch lands, which on a
                # slow runner can be before the first look: either one
                # shows the view answered, and the rows must follow.
                # The rows come under headers, and the cursor is on the
                # first row under the first one, not on the header.
                ninth.press("\r", lambda s: "Loading reminders" in cur(s) or has(s, "Fake water the plants"), what="the Loading row, or the rows already")
                ninth.wait_state(lambda s: has(s, "Unscheduled") and "Fake water the plants" in cur(s), what="the rows under their header, the cursor on the first of them, with no keystroke")
            finally:
                ninth.kill()
        if sys.platform == "darwin":
            check("reminders", reminders)
    finally:
        L.kill()
        # The worker may still be around on a fast failure.
        subprocess.run(["pkill", "-f", f"swoop-ai work"], stderr=subprocess.DEVNULL)
        shutil.rmtree(tmp, ignore_errors=True)
    print("launcher-test: ok")


if __name__ == "__main__":
    main()
