#!/usr/bin/env python3
"""launcher-test: bin/swoop driven through a pseudo-terminal, end to end.

The unit tests cover the rules; this covers the wiring: the fzf flags and
bindings in bin/swoop, swoop-nav's answers to them, the extension calls,
swoop-ai's worker talking back to fzf through its socket. Every bug of one
evening lived in that wiring, and each was caught by a harness like this
one and then thrown away. This one stays.

A temp HOME, a fake extension and a fake AI command make it the same on
every machine; SWOOP_PICTURES=0 and SWOOP_NO_CLIPD=1 keep pictures and the
clipboard watcher out of it. Standard library only. Needs fzf and bin/
built (make build). Run it with `make e2e`.

Terminal output is read as a stream: escape sequences stripped, text
searched. That is enough to say "this word appeared after that key",
which is what every check here is.
"""

import datetime
import glob
import json
import os
import pty
import re
import select
import shutil
import signal
import stat
import socket
import subprocess
import sys
import tempfile
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ESC = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|\x1b[()][A-Z0-9]|\x1b[=>]|\x1b\][^\x07]*\x07|\x1b\\|\x1bP[^\x1b]*\x1b\\")


def fail(msg, tail=""):
    print("launcher-test: FAIL:", msg, file=sys.stderr)
    if tail:
        print("--- last screen output:", file=sys.stderr)
        print(tail[-2500:], file=sys.stderr)
    sys.exit(1)


def write_exe(path, body):
    with open(path, "w") as f:
        f.write(body)
    os.chmod(path, os.stat(path).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)


class Launcher:
    """One swoop in a pseudo-terminal."""

    def __init__(self, env, cols=120, rows=30):
        self.pid, self.fd = pty.fork()
        if self.pid == 0:
            os.execvpe(os.path.join(ROOT, "bin", "swoop"), ["swoop"], env)
        import fcntl
        import struct
        import termios
        fcntl.ioctl(self.fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
        self.raw = ""
        self._buf = ""
        self._stripped_upto = 0
        self.eof = False

    def read(self, seconds):
        """Read for up to `seconds`, appending to the buffer."""
        end = time.time() + seconds
        while time.time() < end:
            r, _, _ = select.select([self.fd], [], [], 0.05)
            if not r:
                continue
            try:
                data = os.read(self.fd, 65536)
            except OSError:
                self.eof = True
                return
            if not data:
                self.eof = True
                return
            self.raw += data.decode("utf-8", "replace")

    @property
    def buf(self):
        """The output so far with escape sequences stripped. Stripping runs
        over the whole raw text each time, because a sequence can arrive
        split across two reads and a per-chunk strip would leave half of
        it behind."""
        if self._stripped_upto != len(self.raw):
            self._buf = ESC.sub("", self.raw)
            self._stripped_upto = len(self.raw)
        return self._buf

    def send(self, text):
        os.write(self.fd, text.encode() if isinstance(text, str) else text)

    def expect(self, pattern, timeout=5.0, what=None):
        """Wait until `pattern` (a regex) shows up in output received since
        the last mark. Returns the match."""
        end = time.time() + timeout
        while True:
            m = re.search(pattern, self.buf[self.mark:])
            if m:
                return m
            if time.time() > end or self.eof:
                fail(f"did not see {what or pattern!r} within {timeout}s", self.buf)
            self.read(0.1)

    sock = None
    key = None

    def state(self):
        """fzf's own account of itself, through its socket: the query, the
        match count, the row under the cursor. Exact where the screen
        stream is not: a redraw in flight can show the old list under the
        new prompt, but fzf knows what it holds."""
        if self.sock is None:
            socks = glob.glob(os.path.join(os.environ["SWOOP_TEST_TMP"], "swoop-state.*.sock"))
            if not socks:
                return None
            self.sock = socks[0]
        try:
            c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            c.settimeout(2)
            c.connect(self.sock)
            c.sendall(f"GET / HTTP/1.0\r\nx-api-key: {self.key}\r\n\r\n".encode())
            data = b""
            while True:
                chunk = c.recv(65536)
                if not chunk:
                    break
                data += chunk
            c.close()
        except OSError:
            return None
        body = data.split(b"\r\n\r\n", 1)[-1]
        try:
            return json.loads(body)
        except ValueError:
            return None

    def wait_state(self, pred, timeout=5.0, what=""):
        """Wait until fzf's state satisfies pred; returns it."""
        end = time.time() + timeout
        while time.time() < end:
            st = self.state()
            if st and pred(st):
                return st
            self.read(0.1)
        fail(f"fzf never reached: {what}; last state {self.state()}", self.buf)

    def clear(self):
        """Mark: later expects see only what comes after this point."""
        self.mark = len(self.buf)

    mark = 0

    def wait_exit(self, timeout=5.0):
        end = time.time() + timeout
        while time.time() < end:
            pid, status = os.waitpid(self.pid, os.WNOHANG)
            if pid:
                return os.WEXITSTATUS(status) if os.WIFEXITED(status) else -1
            self.read(0.1)
        fail("swoop did not exit", self.buf)

    def kill(self):
        # Keep reading while waiting. A process leaving a terminal waits
        # for its output to drain, so a blocking waitpid with nobody
        # reading the pty hung the whole tree in exit, fzf and its
        # preview with it, for good. SIGKILL if it takes too long.
        try:
            os.kill(self.pid, signal.SIGTERM)
        except OSError:
            return
        end = time.time() + 5
        while True:
            try:
                pid, _ = os.waitpid(self.pid, os.WNOHANG)
            except OSError:
                break
            if pid:
                break
            if time.time() > end:
                try:
                    os.kill(self.pid, signal.SIGKILL)
                except OSError:
                    pass
                end = float("inf")
            self.read(0.1)
            if self.eof:
                time.sleep(0.05)
        try:
            os.close(self.fd)
        except OSError:
            pass


def main():
    if not shutil.which("fzf"):
        fail("fzf is not on PATH")
    for tool in ("swoop-nav", "swoop-ai", "swoop-list", "swoop-icons"):
        if not os.path.exists(os.path.join(ROOT, "bin", tool)):
            fail(f"bin/{tool} is not built; run make build")

    tmp = tempfile.mkdtemp(prefix="swoop-launcher-test.")
    home = os.path.join(tmp, "home")
    os.makedirs(os.path.join(home, ".config", "swoop"))
    ext_dir = os.path.join(tmp, "ext", "fake")
    os.makedirs(ext_dir)
    marker = os.path.join(tmp, "ran")

    # The fake extension: one view row, one plain row, a view that filters
    # three words, an action menu, and a run that leaves a marker.
    write_exe(os.path.join(ext_dir, "fake"), f"""#!/usr/bin/env bash
row() {{ printf '%s\\t%s\\t%s\\t%s\\t%s\\n' "$1" "$2" "$3" "$4" "$5"; }}
case "$1" in
  list)
    row things view '' 'Fake Things' 'a view of fake things'
    row plain command '' 'Fake Plain Row' 'runs and leaves a marker' ;;
  view)
    q="${{3:-}}"
    for w in apple banana cherry; do
      case "$w" in *"$q"*) row "$w" fruit '' "$w" 'fruit' ;; esac
    done ;;
  preview) echo "preview of $2" ;;
  actions) row copy action '' 'Copy Fake' 'Enter'; row delete refresh '' 'Delete Fake' '' ;;
  run) echo "$2 ${{3:-}}" > '{marker}' ;;
esac
""")
    # A quicklink with an argument, and a fake `open` (and xdg-open, for
    # Linux) ahead of the real one on PATH that records what it was asked
    # to open instead of opening it.
    with open(os.path.join(home, ".config", "swoop", "quicklinks.tsv"), "w") as f:
        f.write("Fake Search\thttps://example.test/find?q={argument}\n")
    fakebin = os.path.join(tmp, "fakebin")
    os.makedirs(fakebin)
    opened = os.path.join(tmp, "opened")
    for name in ("open", "xdg-open"):
        write_exe(os.path.join(fakebin, name), f"""#!/usr/bin/env bash
printf '%s\\n' "$@" > '{opened}'
""")

    # A snippet with a keyword, a placeholder filled on Enter, and a
    # {cursor}, which outside a frame is only removed.
    snippets = os.path.join(home, ".config", "swoop", "snippets")
    os.makedirs(snippets)
    with open(os.path.join(snippets, "fake-greeting.md"), "w") as f:
        f.write("Fake Greeting\nkeyword: ;fg\n\nHello on {date}{cursor}!\n")

    # A note, with a word inside it that is not in its title.
    notes_dir = os.path.join(home, ".data", "swoop", "notes")
    os.makedirs(notes_dir)
    fake_note = os.path.join(notes_dir, "fake-meeting.md")
    with open(fake_note, "w") as f:
        f.write("# Fake Meeting\n\nremember the zucchini\n")

    # A fake clipboard, pbcopy on a Mac and wl-copy on Linux, that
    # records what it was given.
    copied = os.path.join(tmp, "copied")
    for name in ("pbcopy", "wl-copy"):
        write_exe(os.path.join(fakebin, name), f"""#!/usr/bin/env bash
cat > '{copied}'
""")

    # The fake AI command: a status line on stderr, a pause, an answer.
    with open(os.path.join(home, ".config", "swoop", "ai"), "w") as f:
        f.write("sh -c 'echo \"using Fake\" >&2; sleep 1.2; echo \"The answer is 42\"'\n")

    key = "launcher-test-key"
    os.environ["SWOOP_TEST_TMP"] = tmp
    env = dict(os.environ)
    env.update({
        "FZF_API_KEY": key,
        "HOME": home,
        "XDG_CONFIG_HOME": os.path.join(home, ".config"),
        "XDG_STATE_HOME": os.path.join(home, ".state"),
        "XDG_DATA_HOME": os.path.join(home, ".data"),
        "TMPDIR": tmp,
        "TERM": "xterm-256color",
        "SWOOP_PICTURES": "0",
        "SWOOP_NO_CLIPD": "1",
        "SWOOP_EXTENSIONS": os.path.join(tmp, "ext"),
        "PATH": fakebin + os.pathsep + os.path.join(ROOT, "bin") + os.pathsep + env.get("PATH", ""),
    })
    # Not inside a frame, even when this runs from one: Enter must copy,
    # not send a keystroke to whatever is on the screen.
    env.pop("SWOOP_SHELL", None)
    env.pop("SWOOP_SHELL_PID", None)
    env.pop("SWOOP_PASTE", None)
    config = os.path.join(home, ".config", "swoop", "config")

    def check(name, fn):
        print(f"  {name} ...", end="", flush=True)
        fn()
        print(" ok")

    L = Launcher(env)
    L.key = key
    try:
        # 1. the root list, and typing filters it
        def root():
            # On a Mac the root list holds every app, sorted by title, so
            # the fake rows are off screen until typing narrows it.
            L.send("fake")
            L.expect(r"Fake Things", what="the fake view row after typing 'fake'")
            L.expect(r"Fake Plain Row", what="the fake plain row")
            L.clear()
            L.send(" plain")
            st = L.wait_state(lambda s: s["query"] == "fake plain" and s["matchCount"] == 1, what="one match for 'fake plain'")
            if "Fake Plain Row" not in st["current"]["text"]:
                fail(f"the match should be the plain row: {st['current']}", L.buf)
        check("root list and filter", root)

        # 2. a view: push, ask, Esc clears, Esc pops with the text back
        def view():
            L.send("\x1b")  # Esc: clear the bar
            L.read(0.3)
            L.clear()
            L.send("fake th")
            L.expect(r"Fake Things")
            L.clear()
            L.send("\r")
            L.expect(r"Fake Things > ", what="the view's prompt")
            L.expect(r"banana", what="the view's rows")
            L.clear()
            L.send("err")
            st = L.wait_state(lambda s: s["query"] == "err" and s["matchCount"] == 1, what="the extension leaving one row for 'err'")
            if "cherry" not in st["current"]["text"]:
                fail(f"the one row should be cherry: {st['current']}", L.buf)
            L.clear()
            L.send("\x1b")  # clears 'err'
            L.wait_state(lambda s: s["query"] == "" and s["matchCount"] == 3, what="all three rows back after Esc cleared the bar")
            L.clear()
            L.send("\x1b")  # pops
            L.wait_state(lambda s: s["query"] == "fake th", what="the earlier text back in the bar after popping")
            L.expect(r"Fake Things", what="the root list again")
        check("view push, filter, Esc, Esc", view)

        # 3. the action menu
        def actions():
            L.clear()
            L.send("\x0b")  # ctrl-k on the highlighted view row
            L.expect(r"actions > ", what="the actions prompt")
            L.expect(r"Copy Fake")
            L.expect(r"Delete Fake")
            L.clear()
            L.send("\x1b")
            L.wait_state(lambda s: s["query"] == "fake th", what="back at the root with the text")
        check("action menu", actions)

        # 4. Ask AI: Tab, Enter, thinking, status, answer, Esc Esc
        def ask():
            L.send("\x1b")  # clear the bar
            L.read(0.3)
            L.clear()
            L.send("\t")
            L.expect(r"Ask AI > ", what="the Ask AI prompt")
            L.expect(r"New conversation")
            L.clear()
            L.send("what is the answer")
            L.read(0.3)
            L.send("\r")
            L.expect(r"thinking", timeout=5, what="the conversation row saying thinking")
            L.expect(r"using Fake", timeout=5, what="the command's stderr under the dots")
            L.expect(r"The answer is 42", timeout=8, what="the answer in the preview")
            L.expect(r"1 turn", timeout=5, what="the subtitle after the answer")
            # ctrl-k on New conversation: the model list; Enter on one sets it
            L.send("\x1b[A")  # up, onto New conversation
            L.wait_state(lambda s: "ext/ai/new" in s["current"]["text"], what="the cursor on New conversation")
            L.clear()
            L.send("\x0b")
            L.expect(r"New conversation actions > ", what="the model menu")
            L.expect(r"The line in", what="the custom-line choice in the menu")
            L.send("claude")
            L.wait_state(lambda s: s["query"] == "claude" and s["matchCount"] == 1, what="the claude row")
            L.send("\r")
            L.expect(r"Ask AI > ", what="back in the pane")
            # The pane is back only once New is under the cursor again: a
            # ctrl-k sent before that lands on a model row and is ignored.
            L.wait_state(lambda s: "ext/ai/new" in s["current"]["text"], what="the pane back with New under the cursor")
            with open(config) as f:
                if "ai = claude" not in f.read():
                    fail("ctrl-k on New did not set ai = claude", L.buf)
            # and back to the custom line, so the fake model answers again.
            # The mark moves first: "Ask AI > " is already in the buffer
            # from the pick above, and the expect below must wait for the
            # pane to come back a second time, not find the first.
            L.clear()
            L.send("\x0b")
            L.expect(r"New conversation actions > ", what="the model menu again")
            L.send("The line")
            L.wait_state(lambda s: s["query"] == "The line" and s["matchCount"] == 1, what="the custom-line row")
            L.send("\r")
            L.expect(r"Ask AI > ", what="back in the pane again")
            L.wait_state(lambda s: "ext/ai/new" in s["current"]["text"], what="the pane back with New under the cursor")
            L.clear()
            L.send("\x1b")
            # Back at the root: the whole list, an empty bar (it was empty
            # before Tab).
            L.wait_state(lambda s: s["query"] == "" and s["totalCount"] > 3, what="the root list after Esc from Ask AI")
        check("Ask AI", ask)

        # 5. the divider keys write the width
        def divider():
            # The key's transform writes the file; on a slow runner that
            # can take longer than a fixed pause, so the file is polled.
            def saved(line, timeout=5.0):
                end = time.time() + timeout
                while time.time() < end:
                    with open(config) as f:
                        if line in f.read():
                            return True
                    L.read(0.1)
                return False
            L.send("\x1b[1;3D")  # alt-left
            if not saved("preview = 63"):
                fail("alt-left did not save preview = 63", L.buf)
            L.send("\x1b[1;3C")  # alt-right
            if not saved("preview = 58"):
                fail("alt-right did not save preview = 58", L.buf)
        check("divider keys", divider)

        # 6. Settings: the key opens the pane, a choice sets a value and returns
        def settings_pane():
            # Text in the bar first: Settings keeps it and gives it back on
            # the way out, which is how the return to the root is known.
            L.send("fake")
            L.wait_state(lambda s: s["query"] == "fake", what="text in the bar before Settings")
            L.clear()
            L.send("\x1b,")  # alt-,
            L.expect(r"Settings > ", what="the Settings prompt")
            L.expect(r"Preview width", what="the settings rows")
            L.clear()
            L.send("preview")
            L.wait_state(lambda s: s["query"] == "preview" and s["matchCount"] == 1, what="one row for 'preview'")
            L.send("\r")
            L.expect(r"Preview width > ", what="the choices pane")
            L.clear()
            L.send("70")
            L.wait_state(lambda s: s["query"] == "70" and s["matchCount"] == 1, what="the 70% choice")
            L.send("\r")
            L.wait_state(lambda s: s["query"] == "preview", what="back in Settings with the earlier text")
            L.expect(r"70%", what="the new width in the row's subtitle")
            with open(config) as f:
                if "preview = 70" not in f.read():
                    fail("the choice did not write preview = 70", L.buf)
            L.send("\x1b")  # clears 'preview'
            L.wait_state(lambda s: s["query"] == "", what="the bar cleared in Settings")
            L.send("\x1b")  # pops to the root
            L.wait_state(lambda s: s["query"] == "fake", what="the root with the earlier text back")
            L.send("\x1b")  # and clear it for the next step
            L.wait_state(lambda s: s["query"] == "", what="an empty bar at the root")
        check("Settings pane", settings_pane)

        # 7. Enter on a plain row runs it and the launcher exits
        def run():
            L.clear()
            L.send("plain")
            L.expect(r"Fake Plain Row")
            L.send("\r")
            code = L.wait_exit()
            if not os.path.exists(marker):
                fail(f"the fake extension's run did not happen (exit {code})", L.buf)
            with open(marker) as f:
                if f.read().strip() != "plain":
                    fail("run got the wrong id", L.buf)
        check("Enter runs and exits", run)

        # 8. the open was counted: a new launcher leads with that row, marked
        def recent():
            usage_log = os.path.join(home, ".state", "swoop", "usage.jsonl")
            if not os.path.exists(usage_log):
                fail("the run was not recorded in the usage log", "")
            with open(usage_log) as f:
                if "ext/fake/plain" not in f.read():
                    fail("the usage log does not name the row that ran", "")
            again = Launcher(env)
            again.key = key
            try:
                st = again.wait_state(lambda s: s["totalCount"] > 3, what="the second launcher's list")
                first = st["current"]["text"]
                if "Fake Plain Row" not in first or "recent" not in first:
                    fail(f"the first row should be the recent one, marked: {first!r}", again.buf)
                # Stats lists it too
                again.send("stats")
                again.wait_state(lambda s: s["query"] == "stats" and s["matchCount"] >= 1, what="the Stats row")
                again.send("\r")
                again.expect(r"Stats > ", what="the Stats pane")
                again.expect(r"Fake Plain Row", what="the opened row in Stats")
                again.expect(r"once", what="its count")
            finally:
                again.kill()
        check("Used recently and Stats", recent)

        # 9. a quicklink with an argument: Enter opens its pane, the text
        # typed becomes the row, Enter opens the link with the text in it
        def quicklink():
            third = Launcher(env)
            third.key = key
            try:
                third.wait_state(lambda s: s["totalCount"] > 3, what="the third launcher's list")
                third.send("fake search")
                st = third.wait_state(lambda s: s["query"] == "fake search" and s["matchCount"] == 1, what="the quicklink row")
                if "Fake Search" not in st["current"]["text"]:
                    fail(f"the match should be the quicklink: {st['current']}", third.buf)
                third.clear()
                third.send("\r")
                third.expect(r"Fake Search > ", what="the quicklink's pane")
                third.expect(r"Type, then Enter", what="the pane's hint row")
                third.clear()
                third.send("hello world")
                st = third.wait_state(lambda s: s["query"] == "hello world" and "hello+world" in s["current"]["text"], what="the row carrying the text, link filled in")
                third.send("\r")
                code = third.wait_exit()
                if not os.path.exists(opened):
                    fail(f"the link was not opened (exit {code})", third.buf)
                with open(opened) as f:
                    got = f.read().split()
                if got != ["https://example.test/find?q=hello+world"]:
                    fail(f"open got the wrong arguments: {got}", third.buf)
            finally:
                third.kill()
        check("quicklink with an argument", quicklink)

        # 10. emoji: the view, a search, Enter copies (outside a frame
        # there is no app to paste into); the next time it leads the view,
        # and ctrl-k on a thumbs up offers the six tones
        def emoji():
            fourth = Launcher(env)
            fourth.key = key
            try:
                fourth.wait_state(lambda s: s["totalCount"] > 3, what="the fourth launcher's list")
                fourth.send("emoji")
                fourth.wait_state(lambda s: s["query"] == "emoji" and "Emoji & Symbols" in s["current"]["text"], what="the Emoji & Symbols row")
                fourth.clear()
                fourth.send("\r")
                fourth.expect(r"Emoji & Symbols > ", what="the emoji view")
                fourth.clear()
                fourth.send("rocket")
                fourth.wait_state(lambda s: s["query"] == "rocket" and "\U0001F680" in s["current"]["text"], what="the rocket first")
                fourth.send("\r")
                code = fourth.wait_exit()
                if not os.path.exists(copied):
                    fail(f"Enter on the rocket copied nothing (exit {code})", fourth.buf)
                with open(copied, encoding="utf-8") as f:
                    got = f.read()
                if got != "\U0001F680":
                    fail(f"the clipboard got {got!r}", fourth.buf)
                fourth.expect(r"Copied", what="the note that it was copied")
            finally:
                fourth.kill()
            fifth = Launcher(env)
            fifth.key = key
            try:
                fifth.wait_state(lambda s: s["totalCount"] > 3, what="the fifth launcher's list")
                fifth.send("emoji")
                fifth.wait_state(lambda s: s["query"] == "emoji" and "Emoji & Symbols" in s["current"]["text"], what="the Emoji & Symbols row")
                fifth.send("\r")
                st = fifth.wait_state(lambda s: s["query"] == "" and s["totalCount"] > 1000, what="the whole table in the view")
                first = st["current"]["text"]
                if "\U0001F680" not in first or "recent" not in first:
                    fail(f"the rocket should lead the view, marked: {first!r}", fifth.buf)
                fifth.send("thumbs up")
                fifth.wait_state(lambda s: s["query"] == "thumbs up" and "\U0001F44D" in s["current"]["text"], what="the thumbs up")
                fifth.clear()
                fifth.send("\x0b")
                fifth.expect(r"thumbs up actions > ", what="its actions")
                st = fifth.wait_state(lambda s: s["totalCount"] == 8, what="Paste, Copy and six tones")
                fifth.expect(r"medium-dark", what="the tones")
            finally:
                fifth.kill()
        check("emoji", emoji)

        # 11. a snippet: its name finds its row, Enter copies the text
        # with {date} filled (outside a frame there is no app to paste
        # into, as with emoji)
        def snippet():
            if os.path.exists(copied):
                os.remove(copied)
            sixth = Launcher(env)
            sixth.key = key
            try:
                sixth.wait_state(lambda s: s["totalCount"] > 3, what="the sixth launcher's list")
                sixth.send("fake greeting")
                st = sixth.wait_state(lambda s: s["query"] == "fake greeting" and "Fake Greeting" in s["current"]["text"], what="the snippet row")
                if ";fg" not in st["current"]["text"]:
                    fail(f"the snippet's keyword should be in its row: {st['current']}", sixth.buf)
                before = datetime.date.today().isoformat()
                sixth.send("\r")
                code = sixth.wait_exit()
                after = datetime.date.today().isoformat()
                if not os.path.exists(copied):
                    fail(f"Enter on the snippet copied nothing (exit {code})", sixth.buf)
                with open(copied, encoding="utf-8") as f:
                    got = f.read()
                if got not in (f"Hello on {before}!", f"Hello on {after}!"):
                    fail(f"the clipboard got {got!r}", sixth.buf)
                sixth.expect(r"Copied Hello on", what="the note that it was copied")
            finally:
                sixth.kill()
        check("snippet", snippet)
        # 12. notes: the root row opens the view, the note is in it, a
        # word from inside it still finds it, Enter opens the file; then
        # New note makes a file from what was typed and opens that
        def notes():
            def open_view(ln):
                ln.wait_state(lambda s: s["totalCount"] > 3, what="the launcher's list")
                ln.send("notes")
                ln.wait_state(lambda s: s["query"] == "notes" and s["matchCount"] >= 1, what="rows for 'notes'")
                # On a Mac the Notes app matches too: move to the row
                # that is the extension's.
                for _ in range(10):
                    st = ln.state()
                    if st and "markdown notes" in st["current"]["text"]:
                        break
                    ln.send("\x1b[B")
                    ln.read(0.2)
                else:
                    fail(f"no Notes row: {ln.state()}", ln.buf)
                ln.clear()
                ln.send("\r")
                ln.expect(r"Notes > ", what="the notes view")

            if os.path.exists(opened):
                os.remove(opened)
            eighth = Launcher(env)
            eighth.key = key
            try:
                open_view(eighth)
                st = eighth.wait_state(lambda s: s["query"] == "" and s["matchCount"] == 2, what="New note and the note")
                eighth.expect(r"Fake Meeting", what="the note's title")
                eighth.send("zucchini")
                # The count is 2 before and after the reload, so the wait
                # is on the row text, which only the reload changes.
                eighth.wait_state(lambda s: s["query"] == "zucchini" and s["matchCount"] == 2 and "New note: zucchini" in s["current"]["text"], what="New note leading the view, and the note found by a word inside it")
                eighth.send("\x1b[B")
                st = eighth.wait_state(lambda s: "Fake Meeting" in s["current"]["text"], what="the cursor on the note")
                if "remember the zucchini" not in st["current"]["text"]:
                    fail(f"the matching line should be the subtitle: {st['current']}", eighth.buf)
                eighth.send("\r")
                code = eighth.wait_exit()
                if not os.path.exists(opened):
                    fail(f"the note was not opened (exit {code})", eighth.buf)
                with open(opened) as f:
                    got = f.read().splitlines()
                if [os.path.realpath(g) for g in got] != [os.path.realpath(fake_note)]:
                    fail(f"open got the wrong arguments: {got}", eighth.buf)
            finally:
                eighth.kill()

            os.remove(opened)
            ninth = Launcher(env)
            ninth.key = key
            try:
                open_view(ninth)
                ninth.send("Fake Idea")
                st = ninth.wait_state(lambda s: s["query"] == "Fake Idea" and "New note: Fake Idea" in s["current"]["text"], what="the New note row")
                ninth.send("\r")
                code = ninth.wait_exit()
                made = os.path.join(notes_dir, "fake-idea.md")
                if not os.path.exists(opened):
                    fail(f"the new note was not opened (exit {code})", ninth.buf)
                with open(opened) as f:
                    got = f.read().splitlines()
                if [os.path.realpath(g) for g in got] != [os.path.realpath(made)]:
                    fail(f"open got the wrong arguments: {got}", ninth.buf)
                with open(made) as f:
                    body = f.read()
                if body != "# Fake Idea\n\n":
                    fail(f"the new note holds {body!r}", ninth.buf)
            finally:
                ninth.kill()
        check("notes", notes)

        # 13. the window rows are at the root, with a preview. No Enter:
        # that would move a real window, or, without Accessibility, open
        # System Settings, and neither belongs in a headless run.
        def window():
            seventh = Launcher(env)
            seventh.key = key
            try:
                seventh.wait_state(lambda s: s["totalCount"] > 3, what="the seventh launcher's list")
                seventh.send("left half")
                st = seventh.wait_state(lambda s: s["query"] == "left half" and s["matchCount"] >= 1, what="the Left Half row")
                if "Left Half" not in st["current"]["text"]:
                    fail(f"the first match should be Left Half: {st['current']}", seventh.buf)
                seventh.expect(r"Move the window to the left half", what="the Left Half preview")
            finally:
                seventh.kill()
        check("window rows at the root", window)

        # 13. tasks: the view, a task added with a date word, and Enter
        # on it ticks it while the view stays, reloaded (kind "toggle")
        def tasks():
            tasks_md = os.path.join(home, ".data", "swoop", "tasks.md")
            eighth = Launcher(env)
            eighth.key = key
            try:
                eighth.wait_state(lambda s: s["totalCount"] > 3, what="the eighth launcher's list")
                eighth.send("tasks")
                eighth.wait_state(lambda s: s["query"] == "tasks" and "ext/tasks/tasks" in s["current"]["text"], what="the Tasks row")
                eighth.clear()
                eighth.send("\r")
                eighth.expect(r"Tasks > ", what="the tasks view")
                eighth.wait_state(lambda s: "Type a task" in s["current"]["text"], what="the hint row of an empty list")
                eighth.send("buy milk tomorrow")
                eighth.wait_state(lambda s: s["query"] == "buy milk tomorrow" and "Add task: buy milk" in s["current"]["text"], what="the Add task row")
                # Tomorrow from either side of the Enter, in case it
                # falls across midnight: the file's date and the label.
                before = datetime.date.today()
                eighth.send("\r")
                after = datetime.date.today()
                days = set()
                for d in (before, after):
                    t = d + datetime.timedelta(days=1)
                    days.add((t.isoformat(), f"tomorrow, {t.strftime('%a')} {t.day} {t.strftime('%b')}"))
                eighth.wait_state(lambda s: s["query"] == "" and any(label in s["current"]["text"] for _, label in days) and "buy milk" in s["current"]["text"], what="the new task with tomorrow's date, the view still open")
                with open(tasks_md) as f:
                    got = f.read()
                if not any(f"- [ ] buy milk due: {iso}\n" in got for iso, _ in days):
                    fail(f"the file did not get the task: {got!r}", eighth.buf)
                eighth.send("\r")
                eighth.wait_state(lambda s: "buy milk" in s["current"]["text"] and "done" in s["current"]["text"], what="the task marked done, the view still open")
                with open(tasks_md) as f:
                    got = f.read()
                if "- [x] buy milk due: " not in got:
                    fail(f"Enter did not tick the task in the file: {got!r}", eighth.buf)
                eighth.expect(r"Tasks > ", what="still in the tasks view")
            finally:
                eighth.kill()
        check("tasks", tasks)
    finally:
        L.kill()
        # The worker may still be around on a fast failure.
        subprocess.run(["pkill", "-f", f"swoop-ai work"], stderr=subprocess.DEVNULL)
        shutil.rmtree(tmp, ignore_errors=True)
    print("launcher-test: ok")


if __name__ == "__main__":
    main()
